        <arguments>
          <argument>
            <kind>1</kind>
            <string>var ag;
draw_clear(make_colour_hsv(global.hue,15,255));
draw_set_color(make_colour_hsv(global.hue,70,255));
for(ag=global.vsbk;ag&lt;global.vsbk+360;ag+=60){
  draw_triangle(0,0,lengthdir_x(600,ag),lengthdir_y(600,ag),
  lengthdir_x(600,ag+30),lengthdir_y(600,ag+30),0);
}
global.vsbk-=0.5;
global.hue+=0.25;
if(global.hue&gt;255)global.hue-=255;
if(global.vsbk&lt;0)global.vsbk+=360;

texture_set_interpolation(1);
d3d_set_perspective(1);
d3d_set_hidden(1);
d3d_set_zwriteenable(1);
d3d_set_culling(1);
d3d_set_projection_ext(v_x,v_y,v_z,0,0,0,0,1,0,v_a,view_wview/view_hview,1,1040);
draw_set_color(c_white);
var tex;
tex=surface_get_texture(sf[0]);

d3d_transform_set_identity();
d3d_transform_stack_pop();
if(rtime&gt;0){
  if(xzfx=0){
    d3d_transform_add_rotation_y(rfx);
  }else{
    d3d_transform_add_rotation_z(rfx);
  }
}
d3d_transform_stack_push();

d3d_primitive_begin_texture(pr_trianglelist,tex);
d3d_vertex_texture(-160,160,-160,0,0);
d3d_vertex_texture(-160,160,160,0.25,0);
d3d_vertex_texture(160,160,160,0.25,1/3);
d3d_vertex_texture(160,160,160,0.25,1/3);
d3d_vertex_texture(160,160,-160,0,1/3);
d3d_vertex_texture(-160,160,-160,0,0);
d3d_vertex_texture(160,160,-160,0,1/3);
d3d_vertex_texture(160,160,160,0.25,1/3);
