      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if(view){
  v_r+=(800-v_r)/5;
  x_a+=keyboard_check(ord("D"))/30;
  x_a-=keyboard_check(ord("A"))/30;
  y_a+=keyboard_check(ord("W"))/30;
  y_a-=keyboard_check(ord("S"))/30;
  if(y_a&gt;pi/4)y_a=pi/4;
  if(y_a&lt;-pi/4)y_a=-pi/4;
  if(x_a&gt;2*pi)x_a-=2*pi;
  if(x_a&lt;0)x_a+=2*pi;
  if(keyboard_check_pressed(ord("X")))view=0;
}else{
  if(objVSwarp.change){
    view=0;a+=0.1;
    v_r-=a;x_a+=a/100;
  }else{
    v_r+=(720-v_r)/5;
    if(x_a&gt;pi)x_a-=pi*2;
    x_a-=x_a/10;
    if(room!=rVS01){
      if(keyboard_check_pressed(ord("X")))view=1;
    }
  }
  y_a-=y_a/10;
}
v_x=v_r*cos(x_a)*cos(y_a);
v_y=v_r*sin(y_a);
v_z=v_r*cos(y_a)*sin(x_a);
