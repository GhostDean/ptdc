        <arguments>
          <argument>
            <kind>1</kind>
            <string>if(instance_exists(player)){
  player.visible=false;
  coll=1;
  if(player.y+player.vspeed*4&lt;yy[now]-160){
    fx=90;
  }else if(player.y+player.vspeed*4&gt;yy[now]+160){
    fx=270;
  }else if(player.x+player.hspeed*8&lt;xx[now]-160){
    fx=180;
  }else if(player.x+player.hspeed*8&gt;xx[now]+160){
    fx=0;
  }else{
    coll=0;
  }
}
if(coll=1){
  ang=(fx-dir[now]+360) mod 360;
  switch(now){
    case 1:
      switch(ang){
        case 0:next=3;dir[next]=90;break;
        case 90:next=4;dir[next]=180;break;
        case 180:next=5;dir[next]=270;break;
        case 270:next=2;dir[next]=0;break;
      };
    break;
    case 2:
      switch(ang){
        case 0:next=3;break;
        case 90:next=1;break;
        case 180:next=5;break;
        case 270:next=6;break;
      };
      dir[next]=0;
    break;
    case 3:
      switch(ang){
        case 0:next=4;dir[next]=0;break;
        case 90:next=1;dir[next]=270;break;
        case 180:next=2;dir[next]=0;break;
        case 270:next=6;dir[next]=90;break;
      };
    break;
    case 4:
      switch(ang){
        case 0:next=5;dir[next]=0;break;
        case 90:next=1;dir[next]=180;break;
        case 180:next=3;dir[next]=0;break;
        case 270:next=6;dir[next]=180;break;
      };
    break;
    case 5:
      switch(ang){
        case 0:next=2;dir[next]=0;break;
        case 90:next=1;dir[next]=90;break;
        case 180:next=4;dir[next]=0;break;
        case 270:next=6;dir[next]=270;break;
      };
    break;
    case 6:
      switch(ang){
        case 0:next=3;dir[next]=270;break;
        case 90:next=2;dir[next]=0;break;
        case 180:next=5;dir[next]=90;break;
        case 270:next=4;dir[next]=180;break;
      };
    break;
  }
  dir[next]+=dir[now];
  dir[next]=dir[next] mod 360;
  xx1=xx[now]+lengthdir_x(320,fx);
  yy1=yy[now]+lengthdir_y(320,fx);
  var i,iyy=0,ii=0;
  for(i=1;i&lt;7;i+=1){
    if(i!=next){
      if(xx[i]=xx1 and yy[i]=yy1)ii=i;
    }
    iyy=max(yy[i],iyy);
  }
  yy[ii]=iyy+320;
  xx[next]=xx1;yy[next]=yy1;
  now=next;coll=2;
}

if(rtime=0){
  if(instance_exists(player)){
    if(player.y&lt;from_y){
      xzfx=1;rfx=90/ctime;rtime=ctime;
    }else if(player.y&gt;=from_y+320){
      xzfx=1;rfx=-90/ctime;rtime=ctime;
    }else if(player.x&lt;from_x){
      xzfx=0;rfx=90/ctime;rtime=ctime;
    }else if(player.x&gt;=from_x+320){
      xzfx=0;rfx=-90/ctime;rtime=ctime;
    }
    from_x=floor(player.x/320)*320;
    from_y=floor(player.y/320)*320;
  }
}else{
  rtime-=1;
}
</string>
