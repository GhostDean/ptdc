d3d_vertex_texture(-160,-160,-160,0.75,2/3);
d3d_vertex_texture(-160,-160,160,0.5,2/3);
d3d_vertex_texture(-160,160,160,0.5,1/3);
d3d_vertex_texture(-160,160,-160,0.75,1/3);
d3d_vertex_texture(160,160,-160,1,1/3);
d3d_vertex_texture(160,-160,-160,1,2/3);
d3d_vertex_texture(160,-160,-160,1,2/3);
d3d_vertex_texture(-160,-160,-160,0.75,2/3);
d3d_vertex_texture(-160,160,-160,0.75,1/3);
d3d_vertex_texture(160,-160,-160,0,2/3);
d3d_vertex_texture(160,-160,160,0.25,2/3);
d3d_vertex_texture(-160,-160,160,0.25,1);
d3d_vertex_texture(-160,-160,160,0.25,1);
d3d_vertex_texture(-160,-160,-160,0,1);
