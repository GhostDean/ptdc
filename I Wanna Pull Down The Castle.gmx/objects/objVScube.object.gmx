        <arguments>
          <argument>
            <kind>1</kind>
            <string>if(objVSwarp.change){
  al-=0.05;  
}else{
  if(al&lt;1)al+=0.05;
}
draw_set_alpha(al);
draw_set_halign(fa_center);
draw_set_color(c_dkgray);
draw_set_font(fontVS);
if(view){
  draw_text(400,32,"Press  W A S D  to change perspective");  
}else{ 
  draw_text(400,32,"Press  X  to observe");
}
draw_set_halign(fa_left);
draw_set_alpha(1);
if(v_r&lt;400){
  draw_set_color(c_white);
  draw_set_alpha((400-v_r)/200);
  draw_roundrect(0,0,800,608,0);
  draw_set_alpha(1);
}
