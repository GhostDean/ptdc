        <arguments>
          <argument>
            <kind>1</kind>
            <string>if(!surface_exists(sf[0])){
  sf[0]=surface_create(1280,960);
}
surface_set_target(sf[0]);
draw_clear(make_colour_hsv(global.hue,90,200));
surface_reset_target();
col=make_colour_hsv(global.hue,30,255);
for(n=1;n&lt;7;n+=1){
  if(!surface_exists(sf[n])){
    sf[n]=surface_create(320,320);sfdir[n]=dir[n];
    surface_set_target(sf[n]);
    if(!position_meeting(xx[n]-160,yy[n]-160,objVSblock)){
      draw_clear(c_white);
      draw_set_colour(color1);
      var lx,ly;
      for(lx=0;lx&lt;320;lx+=32){
        for(ly=0;ly&lt;320;ly+=32){
          draw_rectangle(lx,ly,lx+31,ly+31,1);
        }
      }
      draw_set_colour(color3);
      draw_rectangle(0,0,319,319,1);
    }else{
      draw_clear_alpha(0,0);
    }
    with(objVSblock){
      if(n==objVScube.n){
        dx=x-objVScube.xx[objVScube.n]+160;
        dy=y-objVScube.yy[objVScube.n]+160;
        draw_set_color(c_white);
        draw_rectangle(dx,dy,dx+31,dy+31,0);
        draw_set_color(objVScube.color1);
        draw_rectangle(dx,dy,dx+31,dy+31,1);
        draw_set_color(objVScube.color3);
        outx=0;outy=0;
        if(y&lt;objVScube.yy[objVScube.n]-128){
          draw_line(dx-1,dy,dx+31,dy);outy=1;
        }else if(y+32&gt;objVScube.yy[objVScube.n]+128){
          draw_line(dx-1,dy+31,dx+31,dy+31);outy=2;
        }
        if(x&lt;objVScube.xx[objVScube.n]-128){
          draw_line(dx,dy-1,dx,dy+31);outx=1;
        }else if(x+32&gt;objVScube.xx[objVScube.n]+128){
          draw_line(dx+31,dy-1,dx+31,dy+31);outx=2;
        }
      }
    }
    draw_set_color(color2);
    with(objVSblock){
      if(n==objVScube.n){
        if(outy!=1){
          if(x&gt;objVScube.xx[objVScube.n]-160){
            if(!position_meeting(x-32,y-32,objVSblock)){
              draw_line_width(dx-1,dy,dx+1,dy,2);
            }
          }
          if(!position_meeting(x,y-32,objVSblock)){
            draw_line_width(dx-1,dy,dx+31,dy,2);
          }
          if(x+32&lt;objVScube.xx[objVScube.n]+160){
            if(!position_meeting(x+32,y-32,objVSblock)){
              draw_line_width(dx+29,dy,dx+31,dy,2);
            }
          }
        }
        if(outy!=2){
          if(x&gt;objVScube.xx[objVScube.n]-160){
            if(!position_meeting(x-32,y+32,objVSblock)){
              draw_line_width(dx-1,dy+30,dx+1,dy+30,2);
            }
          }
          if(x+32&lt;objVScube.xx[objVScube.n]+160){
            if(!position_meeting(x+32,y+32,objVSblock)){
              draw_line_width(dx+29,dy+30,dx+31,dy+30,2);
            }
          }
          if(!position_meeting(x,y+32,objVSblock)){
            draw_line_width(dx-1,dy+30,dx+31,dy+30,2);
          }
        }
        if(outx!=1){
          if(!position_meeting(x-32,y,objVSblock)){
            draw_line_width(dx,dy-1,dx,dy+31,2);
          }
        }
        if(outx!=2){
          if(!position_meeting(x+32,y,objVSblock)){
            draw_line_width(dx+30,dy-1,dx+30,dy+31,2);
          }
        }
      }
    }
    with(playerKiller){
      if(n==objVScube.n){
        draw_sprite(sprite_index,0,x-objVScube.xx[objVScube.n]+160,y-objVScube.yy[objVScube.n]+160);
      }
    }
    surface_reset_target();
  }
  if(!surface_exists(sf[7])){
    sf[7]=surface_create(320,320);
  }
  surface_set_target(sf[7]);
  draw_clear_alpha(0,0);
  shader_set(shaderVS);
  with(player){
    dx=x-objVScube.xx[objVScube.n]+160;dy=y-objVScube.yy[objVScube.n]+160;
    draw_sprite_ext(sprite_index,-1,dx,dy,image_xscale,1,0,objVScube.col,1);
  }
  with(objVSdeadplayer){
    dx=x-objVScube.xx[objVScube.n]+160;dy=y-objVScube.yy[objVScube.n]+160;
    draw_sprite_ext(sprite_index,-1,dx,dy,image_xscale,1,0,objVScube.col,image_alpha);
    texture_set_interpolation(1);
    draw_sprite_ext(sprVSblood,0,dx,dy,sc,sc,45,objVScube.col,1);
    texture_set_interpolation(0);
  }
  shader_reset();
  if(n==2){
    with(objVSwarp){
      draw_sprite_ext(sprite_index,0,x-objVScube.xx[objVScube.n]+160,
      y-objVScube.yy[objVScube.n]+160,image_xscale,image_yscale,image_angle,objVScube.col,1);
    }
  }
  surface_reset_target();
  surface_set_target(sf[0]);
  if(n==1){
    lx=0;ly=0;
  }else if(n==6){
    lx=0;ly=640;
  }else{
    lx=n*320-640;ly=320;
  }
  switch(sfdir[n]){
    case 0:draw_surface_ext(sf[n],lx,ly,1,1,0,col,1);break;
    case 270:draw_surface_ext(sf[n],lx,ly+319,1,1,90,col,1);break;
    case 180:draw_surface_ext(sf[n],lx+319,ly+319,1,1,180,col,1);break;
    case 90:draw_surface_ext(sf[n],lx+319,ly,1,1,270,col,1);break;
  }
  switch(dir[n]){
    case 0:draw_surface(sf[7],lx,ly);break;
    case 270:draw_surface_ext(sf[7],lx,ly+319,1,1,90,c_white,1);break;
    case 180:draw_surface_ext(sf[7],lx+319,ly+319,1,1,180,c_white,1);break;
    case 90:draw_surface_ext(sf[7],lx+319,ly,1,1,270,c_white,1);break;
  }
  surface_reset_target();
};
view_xview[0]=-400;
view_yview[0]=-304;
