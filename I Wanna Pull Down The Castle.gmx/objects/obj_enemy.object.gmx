    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if instance_exists(objPlayer) &amp;&amp; active
{
    pathStarted = 0;
    if(path_speed &gt; 0)
        path_end();
    event_user(10); //enemy give up logic
}
else
{
    if(isPatrol) {
        if(patrolMode == 0 &amp;&amp; patrolLeft &amp;&amp; patrolRight) {
            if(hspeed &gt; 0) {
                if(x &gt;= patrolRight)
                    hspeed *= -1;
            }
            else {
                if(x &lt;= patrolLeft)
                    hspeed *= -1;
            }
            if(hspeed != 0)
                image_xscale *= sign(hspeed)*sign(image_xscale)
            else
                hspeed = -sign(image_xscale)*moveSpeed;
        }
        else if(patrolMode == 1 &amp;&amp; patrolPath) {
            if(!pathStarted) {
                if(point_distance(x,y,pathStartX, pathStartY) &gt;= moveSpeed) {
                    move_towards_point(pathStartX, pathStartY, moveSpeed); 
                }
                else {
                    x = pathStartX; 
                    y = pathStartY;
                    pathStarted = 1;
                    path_start(patrolPath, moveSpeed, 1, 1);
                }
            }
        }
    }
}

if showHp
{
    if hpBarAlpha &gt; 0 hpBarAlpha -= .01;
    else showHp = 0;
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="4" ename="obj_patrolArea">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if(active)
    exit;
switch (patrolMode)
{
    case 0: //line patrol
        patrolLeft = other.patrolLeft;
        patrolRight = other.patrolRight;
        break;
    case 1: //path patrol
        if(!patrolPath &amp;&amp; other.patrolPath) {
            patrolPath = other.patrolPath;
            pathStartX = path_get_point_x(patrolPath,0);
            pathStartY = path_get_point_y(patrolPath,0);
        }
        break;
    default:
        exit;
}

</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="4" ename="objBullet">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
