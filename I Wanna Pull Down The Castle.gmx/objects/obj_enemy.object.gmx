        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if bullet return -1;
if hp &lt;= 0 return -1;
with other instance_destroy();
if !active active = 1;
hp--;
if hp == 0
{
    audio_play_sound(sndDeath, 0, 0);
    event_user(15);// enemy dead event
}
else
{
    if global.secretItem[7]
    {
        showHp = 1;
        hpBarAlpha = 1;
    }
    audio_play_sound(sndBossHit, 0, 0);
}
// let sprite turn red
image_blend = c_red;
alarm[11] = 5;
</string>
          </argument>
        </arguments>
      </action>
    </event>
