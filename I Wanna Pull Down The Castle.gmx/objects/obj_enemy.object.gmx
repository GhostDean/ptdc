            <kind>1</kind>
            <string>if (scrPlayerDistance() &gt;= giveUpThreshold) {
    giveUpCountdown--;
    if(giveUpCountdown &lt;= 0) {
        active = 0;
    }
}
else {
    giveUpCountdown = GIVEUP_COUNTDOWN;
}
</string>
