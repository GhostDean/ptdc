        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if sprite_exists(sprite_index)
{
    draw_self();
}
if showHp
{
    var _startX = x - abs(sprite_xoffset) + hpBarOffsetX, _startY = y - abs(sprite_yoffset) + hpBarOffsetY;
    var _width = abs(sprite_width);
    draw_set_alpha(hpBarAlpha);
    draw_healthbar(_startX, _startY, _startX + _width, _startY + hpBarHeight, hp / hpmax * 100, 0, c_red, c_green, 0, 0, 1);
    draw_set_alpha(1);
}
if global.debugMode
{
    if !bullet
    {
        if radius &gt; 0 draw_circle_colour(x,y,radius,c_red,c_red,1);
    }
    switch object_index
    {
        case obj_skArcherNormal:
        case obj_skArcherLava:
        case obj_skArcherFrost:
        case obj_skArcherElite:
        case obj_skWarriorNormal:
        case obj_skWarriorLava:
        case obj_skWarriorFrost:
        case obj_skWarriorElite:
        case obj_rifler:
        case obj_riflerElite:
        case obj_shielder:
        case obj_shielderElite:
        case obj_worm:
        case obj_moai:
        case obj_hellBeast:
        case obj_hellBeastElite:
        case obj_hellHound:
        case obj_nightmare:
            draw_rectangle_colour(x,y-rectOffsetY,x+rectWidth*image_xscale,y-rectOffsetY+rectHeight,c_red,c_red,c_red,c_red,1);
            break;
    }
}
</string>
          </argument>
        </arguments>
