          <argument>
            <kind>1</kind>
            <string>//chronosphere disappear
if(chrono_times &gt; 0){
    float = false;
    state = -1;
    audio_play_sound(sndS4Boss_Appear,0,false);
    sprite_index = sprS4Boss_Magic_1;
    if(!second_life)sprite_index = sprS4Boss_2_Magic_1;
    image_index = 0;
    chrono_times -= 1;
    alarm[11] = 20;
}
else{
    if(second_life){
        alarm[6] = 20;
    }
    else{
        alarm[8] = 20;
    }
}
</string>
