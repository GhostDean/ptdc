    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if(hurt_count &gt; 0){
    hurt_count -= 1;
    if(hurt_count == 0)nohurt = false;
}

if(hurt_alpha &gt; 0)hurt_alpha -= 0.015;

if(float){
    float_place += float_speed
    y += float_range * sin(float_place);
}

switch(state){
    case -1:{
        image_xscale += 0.1;
        image_yscale -= 0.1;
        if(image_yscale &lt; 0){
            image_xscale = 2;
            image_yscale = 0;
            state = -2;
        }
    }break;
    case 1:{
        image_xscale -= 0.1;
        image_yscale += 0.1;
        if(image_xscale &lt; 1){
            image_xscale = 1;
            image_yscale = 1;
            float = true;
            state = 0;
        }
    }break;
    case 2:{
        image_alpha -= 0.02;
        if(image_alpha &lt; 0.02){
            x = 800;
            y = 224+608;
            state = -2;
            sprite_index = sprS4Boss_2;
        }
    }break;
    case 3:{
        image_alpha += 0.02;
        if(image_alpha &gt; 1){
            float = true;
            state = 0;
        }
    }break;
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="4" ename="objBullet">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>with(other)instance_destroy();
if(nohurt)return(false);    //hurt colding

nohurt = true;
audio_play_sound(sndBossHit,0,false);

damage = choose(1,1,1,1,1,1,2,2,2,3);
hp -= damage;     //random damage

a = instance_create(other.x + irandom_range(-8,8),other.y + irandom_range(-4,4),objBossHurtNum);
a.image_index = damage;  //damage number effect

hurt_alpha += 0.25;
if(hurt_alpha &gt; 0.8)hurt_alpha = 0.8; //damage red light effect

hurt_count = hurt_cold;   //hurt cold
if(hp &lt;= 0){
    if(second_life){
        obj_bossHpBar.kind = 2;
        scrStopMusic();
        audio_play_sound(sndS4Boss_Appear_2,0,false);
        
        second_life = false;
        hp_max = 80;
        hp = hp_max;
        maxHp = hp;
        
        state = 2;
        float = false;
        
        a = instance_create(x,y,objS4BossExplosionControl);
        a.par_x = x;
        a.par_y = y;
        hurt_count = 230;
        a = instance_create(0,0,objS4Boss_Attack_7);
        a.alarm[0] = 120;
        alarm[7] = 170;
        
        alarm[6] = 0;
        alarm[9] = 0;
        alarm[10] = 0;
        alarm[11] = 0;
        
        with(objS4Boss_Attack_1)instance_destroy();
        with(objS4Boss_Attack_2)instance_destroy();
        with(objS4Boss_Attack_3)instance_destroy();
        with(objS4Boss_Attack_4)instance_destroy();
        with(objS4Boss_Attack_5)instance_destroy();
        with(objS4Boss_Attack_6)instance_destroy();
        
        with(objS4Boss_Bullet_2)instance_destroy();
        with(objS4Boss_Bullet_3)instance_destroy();
        with(objS4Boss_Bullet_4_0)over = true;
        with(objS4Boss_Bullet_4){
            a = scrCreateShadow(0,10);
            a.speed = hspeed;
            a.direction = direction;
            instance_destroy();
        }
        with(objS4Boss_Bullet_4_2){
            a = scrCreateShadow(0,10);
            a.speed = hspeed;
            a.direction = direction;
            instance_destroy();
        }
        with(objS4Boss_Bullet_4_2_2){
            a = scrCreateShadow(0,10);
            a.speed = hspeed;
            a.direction = direction;
            instance_destroy();
        }
        with(objS4Boss_Bullet_4_3)instance_destroy();
        with(objS4Boss_Bullet_5){
            a = scrCreateShadow(0,10);
            a.speed = hspeed;
            a.direction = direction;
            instance_destroy();
        }
        with(objS4Boss_Bullet_5_3)instance_destroy();
        with(objS4Boss_Spikemini)instance_destroy();
        with(objS4Boss_Bullet_6)instance_destroy();
        with(objS4Boss_Bullet_7)instance_destroy();
    }
    else{
        
        
        with objBossBlock instance_destroy();
    
        with(objS4Boss_Attack_1_2)instance_destroy();
        with(objS4Boss_Attack_2_2)instance_destroy();
        with(objS4Boss_Attack_3_2)instance_destroy();
        with(objS4Boss_Attack_4_2)instance_destroy();
        with(objS4Boss_Attack_5_2)instance_destroy();
        with(objS4Boss_Attack_6)instance_destroy();
        
        with(objS4Boss_Bullet_2)instance_destroy();
        with(objS4Boss_Bullet_3)instance_destroy();
        with(objS4Boss_Bullet_4_0)over = true;
        with(objS4Boss_Bullet_4){
            a = scrCreateShadow(0,10);
            a.speed = hspeed;
            a.direction = direction;
            instance_destroy();
        }
        with(objS4Boss_Bullet_4_2){
            a = scrCreateShadow(0,10);
            a.speed = hspeed;
            a.direction = direction;
            instance_destroy();
        }
        with(objS4Boss_Bullet_4_2_2){
            a = scrCreateShadow(0,10);
            a.speed = hspeed;
            a.direction = direction;
            instance_destroy();
        }
        with(objS4Boss_Bullet_4_3)instance_destroy();
        with(objS4Boss_Bullet_5){
            a = scrCreateShadow(0,10);
            a.speed = hspeed;
            a.direction = direction;
            instance_destroy();
        }
        with(objS4Boss_Bullet_5_3)instance_destroy();
        with(objS4Boss_Spikemini)instance_destroy();
        with(objS4Boss_Bullet_6)instance_destroy();
        with(objS4Boss_Bullet_7)instance_destroy();
        global.bossItem[3] = 1;
        scrSaveGame(0);
        with(objBossBlock)instance_destroy();
        if audio_is_playing(sndS4Boss_2)audio_stop_sound(sndS4Boss_2);
        instance_create(784,672,objMovingPlatform);
        instance_create(784,544,objMovingPlatform);
        instance_destroy();
    }
}
</string>
          </argument>
        </arguments>
      </action>
