        <arguments>
          <argument>
            <kind>1</kind>
            <string>if global.bossItem[3] instance_destroy();

image_speed = 0.2;

scrPlayMusic(sndS4Boss_1,true);

hp = 100;
maxHp = hp;
hp_max = hp;

second_life = true;

state = 0;  //if appear or disappear
/*state instruction
-2  nothing (not kill)
-1  flash out
0   normal  (kill)
1   flash in
2   disappear by frame
3   appear by frame
*/

nohurt = false;
hurt_count = 0;
hurt_cold = 6;
damage = 0;
hurt_alpha = 0; //hurt effect

float = true;
float_place = 0;
float_range = 0.8;
float_speed = pi/90;   //float efffect

chrono_times = 0;
chrono_cold = 275;

alarm[0] = 5;   //create shadow
alarm[1] = 60;  //start batle

/*alarm instruction
[0] create shadow
[1] hurt cd
[2] stage 1 start
[3] stage 1 first falsh
[4] stage 1 appear
[5] stage 1 prepare

[6] stage 1 attack

[7] stage 1 into stage 2
[8] stage 2 appear

[9] stage 2 attack

[10]flash out
[11]falsh in
*/   
</string>
          </argument>
        </arguments>
      </action>
    </event>
