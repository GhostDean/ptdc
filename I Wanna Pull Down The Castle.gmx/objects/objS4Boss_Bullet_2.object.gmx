        <arguments>
          <argument>
            <kind>1</kind>
            <string>if(image_alpha &lt; 1)image_alpha += 0.0083;

if(kill){
    shadow_count += 1;
    if(shadow_count == shadow_cold){
        shadow_count -= shadow_cold;
        a = instance_create(x,y,objS4Boss_Bullet_2_Effect);
        a.speed = random_range(4,6);
        a.image_angle = image_angle;
        if(speed != 0){
            a.direction = direction - 180 + random_range(-15,15);
        }
        else{
            a.direction = irandom(360);
        }
    }
}
else{
    if(sniper and instance_exists(objPlayer)){
        dir = point_direction(x,y,objPlayer.x,objPlayer.y);
        if(abs(image_angle - dir) &gt; 5){
            image_angle += (dir - image_angle) * 0.2   
        }
        else{
            image_angle = dir;
        }
    }
    else{
        image_angle += 10;
    }
}
</string>
