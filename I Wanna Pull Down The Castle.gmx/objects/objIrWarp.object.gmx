image_yscale = image_xscale;

if(instance_exists(playerIr) &amp;&amp; x &lt; playerIr.x + 1800){
    /*if(x &lt; playerIr.x + 1000){
        if(SS_GetSoundVol(SE_IrWarp) &lt; 1*(2000+80*global.audio_sound_volume)){
