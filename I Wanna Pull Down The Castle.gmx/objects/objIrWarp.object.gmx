        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>draw_set_color(c_white);
draw_set_alpha(0.2);
for(i = 1;i &lt;= 10;i += 1){
    if((i mod 2)){
        for(j = 0;j &lt; 4;j += 1){
            draw_triangle(x,y,x + 1000 * cos(pi * (ia + i * 36 + j * 9) / 180),y - 1000 * sin(pi * (ia + i * 36 + j * 9) / 180),x + 1000 * cos(pi * (ia + i * 36 + (j + 1) * 9) / 180),y - 1000 * sin(pi * (ia + i * 36 + (j + 1) * 9) / 180),false);
        }
    }
}
for(i = 0;i &lt; 12;i += 1){
    draw_triangle(x,y,x + r * cos(pi * i / 6),y - r * sin(pi * i / 6),x + r * cos(pi * (i + 1) / 6),y - r * sin(pi * (i + 1) / 6),false);
}
for(i = 0;i &lt; 12;i += 1){
    draw_triangle(x,y,x + 0.8 * r * cos(pi * i / 6),y - 0.8 * r * sin(pi * i / 6),x + 0.8 * r * cos(pi * (i + 1) / 6),y - 0.8 * r * sin(pi * (i + 1) / 6),false);
}
draw_set_alpha(1);
draw_self();
</string>
          </argument>
        </arguments>
      </action>
