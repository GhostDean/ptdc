    <event eventtype="4" ename="playerIr">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if (room_exists(roomTo)) {
    room_goto(roomTo);
    if (warpX!=0 || warpY!=0) {
        if (!instance_exists(playerIr)) {
            instance_create(warpX, warpY, playerIr);
        }
        if playerIr.vspeed&lt;0{
            playerIr.vspeed=0;
        }
        if(warpX!=0){
            playerIr.x = warpX;
        }
        else{
            playerIr.x += screens*800;
        }
        //similar as travelling vertically
        if(warpY!=0){
            playerIr.y = warpY;
        }
        else{
            playerIr.y += screens*608;
        }
    }
    else{
        with(playerIr){
            instance_destroy();
        }
    }
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
