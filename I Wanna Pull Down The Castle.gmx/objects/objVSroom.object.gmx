            <kind>1</kind>
            <string>var a=instance_create(400,304,objVSstar);
a.direction=random(360);
a.gravity=random_range(0.02,0.025)+(count+40)/2000;
a.speed=spd;
a.gravity_direction=a.direction;
if(count&lt;20){
  var rand=(20-count);
  a.speed=random(spd+rand/30);
}
count+=1;
if(count&lt;100){
  alarm[0]=(250-count)/50;
  spd+=(count+40)/2000*alarm[0];
}else{
  alarm[2]=150;
}
</string>
          </argument>
        </arguments>
      </action>
