    <event eventtype="8" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if(start=0){
  if(dal&lt;1)dal+=0.05;
  if(keyboard_check_pressed(vk_shift)){
    start=1;
    audio_play_sound(sndInit,1,0);
    alarm[0]=2;
    alarm[1]=1;
  }
}else{
  if(draw=0 and dal&gt;0)dal-=0.05;
}
if(draw){
  if(sc&lt;1.6){sc+=0.02;}
  else{
    if(sd&gt;0){
      sd-=0.0005;
      sc+=sd;
    }
  }
}
draw_sprite_ext(sprVSroom,0,400,304,sc,sc,0,c_white,1);
if(draw=1)draw_sprite_ext(sprSleep,0,400-50*sc,304+34*sc,sc/2,sc/2,0,c_white,1);
if(instance_exists(player)){
  if(player.x&gt;374 and player.y&gt;388 and
     player.x&lt;396 and player.y&lt;400){
    if(dal&lt;1)dal+=0.1;
    if(keyboard_check_pressed(vk_up)){
      if(!instance_exists(objVSlight)){
        var a=instance_create(0,0,objVSlight);
        a.col=c_black;a.al=0;a.a=-0.02;
        alarm[4]=80;
      }
    }
  }else{
    if(dal&gt;0)dal-=0.1;
  }
}
if(dal&gt;0){
  draw_set_font(fontVS);
  draw_set_halign(fa_center);
  if(text="Press Shift"){
    draw_set_alpha(dal);
    draw_set_color(c_white);
    draw_text(400,280,text);
  }else{
    var tw=string_width(text)/2+12;
    draw_set_alpha(dal/2);
    draw_set_color(c_black);
    draw_roundrect(400-tw,220,400+tw,260,0);
    draw_set_alpha(dal);
    draw_set_color(c_white);
    draw_text(400,230,text);
  }
  draw_set_halign(fa_left);
  draw_set_alpha(1);
}
</string>
          </argument>
        </arguments>
      </action>
