    <event eventtype="2" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Decide State
curState = choose(STATE_JUMP_ATTACK, STATE_ROTATE_PLATFORM, STATE_FIREBALL);

if hp &lt;= maxHp / 1.5 &amp;&amp; !didBlindAttack
{
    didBlindAttack = 1;
    curState = STATE_BLIND_FIREBALL;
}
else if hp &lt;= maxHp / 2.5 &amp;&amp; !didMemorizeAttack
{
    didMemorizeAttack = 1;
    curState = STATE_MEMORY_ATTACK;
}

switch curState
{
    case STATE_MEMORY_ATTACK:
        etcDisabled = 1;
        break;
    case STATE_JUMP_ATTACK:
        sprDisabled = 1;
        // up and down
        for (var i = 64; i &lt;= 704; i += 32)
        {
            if i &lt; 352 || i &gt;= 448
            {
                with instance_create(i, 320, obj_mkSpike) down = 1;
                with instance_create(i, 544, obj_mkSpike) up = 1;
            }
        }
        // left and right
        for (var i = 352; i &lt;= 512; i += 32)
        {
            for (var j = 0; j &lt; 2; j++)
            {
                if j == 0 &amp;&amp; i &gt; 448
                {
                    continue;
                }
                with instance_create(32 + 704 * j, i, obj_mkSpike)
                {
                    if j == 0 right = 1;
                    else left = 1;
                }
            }
        }
        break;
    case STATE_ROTATE_PLATFORM:
        audio_play_sound(sndBlockChange, 0, 0);
        drawPlatformMoveLine = 1;
        with instance_create(0, 0, obj_mkWarning)
        {
            kind = 1;
        }
        for (var i = 0; i &lt; 2; i += 1)
        {
            var rotate = instance_create(160 + 448 * i, 448, obj_mkRotate);
            rotate.dirspd = 2 + -4 * i;
            rotate.movedir = 1 + -2 * i;
            rotate.movespd = 2;
        }
        for (var xx = 64; xx &lt;= 704; xx += 32)
        {
            if xx &lt; 352 || xx &gt;= 448
            {
                with instance_create(xx, 512, obj_mkSpike)
                {
                    up = 1;
                    image_alpha = 0;
                }
            }
        }
        break;
    case STATE_FIREBALL:
        gravity = 0;
        fireballPhase = 0;
        fireballTimer = 0;
        etcDisabled = 1;
        sprDisabled = 1;
        audio_play_sound(sndAppear, 0, 0);
        break;
    case STATE_BLIND_FIREBALL:
        blackAlp = 0;
        break;
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Main
if hp == 0
{
    if timeline_running timeline_running = 0;
    exit;
}
if !instance_exists(objPlayer) exit;
switch curState
{
    case STATE_IDLE:
        if hspeed != 0 hspeed = 0;
        break;
    case STATE_BLINK:
        if abs(image_xscale) &gt; 0
        {
            image_xscale -= .1 * sign(image_xscale);
            image_yscale *= 1.1;
            if image_xscale == 0//abs(image_xscale) &lt; .1
            {
                event_user(0);
                image_alpha = 0;
            }
        }
        else
        {
            event_user(1);
            curState = STATE_IDLE;
            // alarm[0] = random_range(30, 50) + waitTime;
            alarm[0] = random_range(80, 100) + waitTime;
            waitTime = 0;
        }
        break;
    case STATE_MEMORY_ATTACK:
        if image_alpha &gt; 0 image_alpha -= .1;
        if !timeline_running
        {
            timeline_index = tl_mkMemoryAttack;
            timeline_running = 1;
        }
        break;
    case STATE_JUMP_ATTACK:
        scrCreateShadow(0, c_white);
        if y &gt; 416 &amp;&amp; jumpTimer == 0
        {
            scrChangeImage(sprPlayerFall, 1);
            gravity = 0;
            y = max(y - 4, 416);
        }
        else
        {
            if jumpTimer &lt; 40
            {
                if jumpTimer == 0
                {
                    jumpPosX = x;
                    jumpPosY = y;
                }
                jumpTimer++;
                x = jumpPosX + random_range(-2, 2);
                y = jumpPosY + random_range(-2, 2);
                if jumpTimer == 40
                {
                    x = jumpPosX;
                    y = jumpPosY;
                }
            }
            else
            {
                if gravity == 0
                {
                    vspeed = -4;
                    gravity = .5;
                }
            }
        }
        break;
    case STATE_ROTATE_PLATFORM:
        if rotateShoot
        {
            if rotateShootTimer &lt; 75
            {
                rotateShootTimer++;
                if !rotateInterval
                {
                    // rotateInterval = 7;
                    rotateInterval = 10;
                    event_user(1);
                    audio_play_sound(sndShoot, 0, 0);
                    with instance_create(x, y, obj_mkBullet)
                    {
                        direction = scrLookAtPlayer();
                        speed = 8;
                    }
                }
                else
                {
                    rotateInterval--;
                }
            }
            else
            {
                with obj_mkRotate fade = 1;
                with obj_mkWarning fade = 1;
                drawPlatformMoveLine = 0;
                rotateShootTimer = 0;
                rotateInterval = 0;
                rotateShoot = 0;
                with obj_mkSpike instance_destroy();
                curState = STATE_IDLE;
                alarm[1] = 10;
            }
        }
        break;
    case STATE_FIREBALL:
        switch fireballPhase
        {
            case 0:
                if image_alpha &gt; 0 image_alpha -= .1;
                else fireballPhase = 1;
                break;
            case 1:
                x = 384 + 17;
                y = 384 + 23;
                gravity = 0;speed = 0;
                scrChangeImage(sprPlayerFall, 1);
                if image_alpha &lt; 1 image_alpha += .1;
                else fireballPhase = 2;
                break;
            case 2:
                if fireballTimer &lt; 100
                {
                    fireballTimer++;
                    if fireballTimer mod 5 == 0
                    {
                        with instance_create(x, y, obj_hellBeastFireball)
                        {
                            direction = random(360);
                            speed = 6;
                            image_angle = direction;
                        }
                    }
                }
                else
                {
                    var _dir = random(360);
                    var _num = irandom_range(6, 7);
                    var _spd = random_range(5, 10);
                    scrMakeShapes(x, y, _dir, 3, _num, _spd, obj_hellBeastFireball);
                    scrMakeShapes(x, y, _dir + 180, 3, _num, _spd, obj_hellBeastFireball);
                    with obj_hellBeastFireball image_angle = direction;
                    etcDisabled = 0;
                    sprDisabled = 0;
                    waitTime = 20;
                    alarm[1] = 1;
                }
                break;
        }
        break;
    case STATE_BLIND_FIREBALL:
        if blackAlp &lt; 0.8 &amp;&amp; blindFireballCount &lt; 5
        {
            blackAlp += .02;
        }
        else
        {
            if blindFireballTimer == 0
            {
                if blindFireballCount &lt; 5
                {
                    audio_play_sound(sndFireball, 0, 0);
                    blindFireballTimer = 80;
                    blindFireballCount++;
                    var _kind = irandom(3);
                    for (var i = 0; i &lt; 4; i++)
                    {
                        var _xx, _dir;
                        _xx = 0 + 800 * (x &gt; 352);
                        _dir = -1 + 2 * (x &lt;= 352);
                        if i != _kind
                        {
                            with instance_create(_xx, 520-32*i, obj_hellBeastFireball)
                            {
                                depth = other.depth - 1;
                                hspeed = 6 * _dir;
                                image_xscale = _dir;
                                image_xscale *= 3;
                                image_yscale *= 1;
                                image_speed = .3;
                            }
                        }
                    }
                }
                else
                {
                    if blackAlp &gt; 0
                    {
                        blackAlp -= .1;
                    }
                    else
                    {
                        curState = STATE_IDLE;
                        blindFireballCount = 0;
                        blindFireballTimer = 0;
                        alarm[1] = 5;
                    }
                }
            }
            else
            {
                blindFireballTimer--;
            }
        }
        break;
}
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Change Sprite
if !sprDisabled
{
    if hspeed != 0
    {
        scrChangeImage(sprPlayerRunning, .5);
        image_xscale = sign(hspeed);
    }
    else
    {
        scrChangeImage(sprPlayerIdle, .2);
    }
    
    if vspeed &lt; -.05 scrChangeImage(sprPlayerJump, 1);
    if vspeed &gt; .05 scrChangeImage(sprPlayerFall, 1);
}
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Etc.
if etcDisabled exit;
if image_alpha &lt; 1 image_alpha += .01;
</string>
