    <event eventtype="4" ename="obj_mkTrigger">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>switch curState
{
    case STATE_JUMP_ATTACK:
        if !jumpCollided
        {
            jumpCollided = 1;
            with obj_mkSpike move = 1;
            with instance_create(0, 0, obj_mkEffect)
            {
                kind = 2;
                time = 3;
            }
            var _bulletNum = 4;
            if hp &lt; maxHp / 3 _bulletNum = 8;
            for (var i = 0; i &lt; _bulletNum; i++)
            {
                for (var j = 0; j &lt; 2; j++)
                {
                    with instance_create(x, y, obj_mkBullet)
                    {
                        kind = 1;
                        rspd = 3;
                        dir = 360 / _bulletNum * i;
                        dirspd = 2 + -4 * j;
                        centerx = other.x;
                        centery = other.y;
                        image_xscale = 1.5;
                        image_yscale = 1.5;
                    }
                }
            }
        }
        sprDisabled = 0;
        jumpCollided = 0;
        curState = STATE_IDLE;
        jumpTimer = 0;
        alarm[1] = 30;
        break;
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
