            <kind>1</kind>
            <string>if image_alpha == 0 exit;
if curState == STATE_MEMORY_ATTACK || curState == STATE_BLIND_FIREBALL exit;
with other instance_destroy();
hp--;
//curHpWidth = sprite_get_width(sprMoaiKingHPBar) * (hp / maxHp);
if hp &gt; 0
{
    audio_play_sound(sndBossHit2, 0, 0);
    image_blend = c_red;
    alarm[11] = 2;
}
else
{
    //with(objSpikeUp)instance_destroy();
    global.bossItem[5]=1
    audio_play_sound(sndDeath, 0, 0);
    instance_create(x, y, objBloodEmitter);
    instance_destroy();
}
</string>
