      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// State Definitions
STATE_IDLE = 1;
STATE_BLINK = 2;
STATE_MEMORY_ATTACK = 3;
STATE_JUMP_ATTACK = 4;
STATE_ROTATE_PLATFORM = 5;
STATE_FIREBALL = 6;
STATE_BLIND_FIREBALL = 7;

/// &lt; State Variables &gt;
// &lt; Jump Attack &gt;
jumpTimer = 0;
jumpCollided = 0;
jumpPosX = 0;
jumpPosY = 0;
// &lt; Rotate Platform Attack &gt; 
rotateShoot = 0;
rotateShootTimer = 0;
rotateInterval = 0;
drawPlatformMoveLine = 0;
// &lt; Fireball Attack &gt;
fireballPhase = 0;
fireballTimer = 0;
// &lt; Memorize Attack &gt;
didMemorizeAttack = 0;
memorizeAttackPhase = 0;
// &lt; Blind Fireball Attack &gt;
didBlindAttack = 0;
blindFireballCount = 0;
blindFireballTimer = 0;

curState = STATE_IDLE;

alarm[1] = 25;
</string>
          </argument>
        </arguments>
      </action>
    </event>
