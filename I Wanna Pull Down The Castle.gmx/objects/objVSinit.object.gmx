    <event eventtype="8" enumb="64">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>d3d_set_projection_ortho(0,0,800,608,0);
d3d_set_hidden(false);d3d_set_culling(false);
draw_set_font(fontVS);
if(room=rVSInit){
  draw_sprite_ext(sprVSwarp,0,400,192,6,6,ang,c_white,1);
  draw_set_color(c_white);
  draw_set_alpha(0.5);
  var i,xx1,xx2,yy1,yy2;
  for(i=0;i&lt;12;i+=1){
    if(d[i]=1){
      if(len[i]&lt;600)len[i]+=60;
      draw_primitive_begin(pr_trianglelist);
      draw_vertex(400,224);
      draw_vertex(400+lengthdir_x(len[i],dir[i]-7),224+lengthdir_y(len[i],dir[i]-7))
      draw_vertex(400+lengthdir_x(len[i],dir[i]+7),224+lengthdir_y(len[i],dir[i]+7))
      draw_primitive_end();
    }
  }
  draw_set_alpha(1);
  if(lt){if(al&lt;1)al+=0.01}
}else{
  if(dt){
    if(tal&lt;1)tal+=0.1;
    if(teach){
      if(instance_exists(player)){
        if(player.x&gt;ptx and player.x&lt;ptx+pww and player.y&gt;pty and player.y&lt;pty+32){
          if(keyboard_check_pressed(ord("S"))){
            alarm[5]=1;
          }
        }
      }
    }
  }else{
    if(tal&gt;0)tal-=0.1;
  }
  draw_set_color(c_dkgray);
  draw_set_alpha(tal/2);
  draw_set_font(fontVS);
  if(tptch=0){
    var tw=string_width(text)/2+12;
    if(tw&gt;20){
      draw_roundrect(draw_x-tw,draw_y-30,draw_x+tw,draw_y+10,0);
    }
    draw_set_alpha(tal);
    draw_set_halign(fa_center);
    draw_set_color(c_white);
    draw_text(draw_x,draw_y-20,text);
    draw_set_halign(fa_left);
  }else if(tptch=1){
    draw_roundrect(190,240,610,368,0);
    draw_set_alpha(tal);
    draw_set_color(c_white);
    draw_text(208,254,text);
    draw_sprite(sprVSxyz,0,520,260);
  }else if(tptch&gt;1){
    draw_roundrect(200,180,600,420,0);
    draw_set_alpha(tal);
    draw_set_color(c_white);
    draw_set_halign(fa_center);
    draw_text(400,192,"Here are some instances.");
    draw_set_font(fontVSs);
    draw_text(320,392,"Your perspective");
    draw_text(480,392,"Right elevation");
    draw_set_halign(fa_left);
    if(tptch=2){
      draw_sprite_ext(sprVSblk,4,304,340,2,2,0,c_white,tal);
      draw_sprite_ext(sprVSblk,4,496,340,2,2,0,c_white,tal);
      draw_sprite_ext(sprVSblk,5,464,276,2,2,0,c_white,tal);
      draw_sprite_ext(sprVSblk,5,432,276,2,2,0,c_white,tal);
      draw_sprite(sprVSspkup,0,464,244);
    }else if(tptch=3){
      draw_sprite_ext(sprVSblk,4,320,340,2,2,0,c_white,tal);
      draw_sprite_ext(sprVSblk,4,480,340,2,2,0,c_white,tal);
      draw_sprite_ext(sprVSblk,5,448,276,2,2,0,c_white,tal);
      draw_sprite_ext(sprVSblk,5,480,276,2,2,0,c_white,tal);
      draw_sprite(sprVSspkup,0,448,244);
    }else if(tptch=4){
      //draw_sprite(sprVSspkdown,0,304,276);
      draw_sprite(sprVSspkdown,0,432,276);
      draw_sprite(sprVSspkdown,0,464,276);
      draw_sprite_ext(sprVSblk,4,304,340,2,2,0,c_white,tal);
      draw_sprite_ext(sprVSblk,4,480,340,2,2,0,c_white,tal);
      draw_sprite_ext(sprVSblk,5,448,276,2,2,0,c_white,tal);
      //draw_sprite_ext(sprVSblk,5,432,276,2,2,0,c_white,tal);
      draw_sprite(sprVSspkup,0,432,244);
      draw_sprite(sprVSspkup,0,464,244);
    }
    if(ystimer=0){
      gravity=0;y=0;image_xscale=1;vspeed=0;
      if(tptch=3){x=16}else{x=0}
    }
    var imind=ystimer div 5;
    if(ystimer&lt;40){
      draw_sprite_ext(sprPlayerIdle,imind,320+x,y+331,image_xscale,1,0,c_white,tal);
    }else if(ystimer&lt;71){
      if(vspeed&lt;0){
        draw_sprite_ext(sprPlayerJump,imind,320+x,y+331,image_xscale,1,0,c_white,tal);
      }else{
        draw_sprite_ext(sprPlayerFall,imind,320+x,y+331,image_xscale,1,0,c_white,tal);
      }
    }
    if(ystimer=39){
      vspeed=-8.5;gravity=0.4;
    }
    if(tptch=3){
      if(ystimer=54){
        hspeed=-3;image_xscale=-1;
      }
      if(ystimer=60){
        hspeed=0;
      }
    }else if(tptch=4){
      if(ystimer=48){
        hspeed=3;
      }
      if(ystimer=52){
        hspeed=0;
      }
    }
    if(vspeed&gt;0 and y&gt;-64){
      y=-64;gravity=0;vspeed=0;
    }
    if(tptch=3){
      draw_sprite_ext(sprVSblk,5,288,276,2,2,0,c_white,tal);
      draw_line(496,y+319,496,y+340);
    }else{
      draw_sprite_ext(sprVSblk,5,304,276,2,2,0,c_white,tal);
    }
    if(ystimer&gt;70){
      if(tptch=2){
        draw_sprite(sprVSspkup,0,304,244);
      }
      draw_sprite_ext(sprPlayerIdle,imind,320+x,y+331,image_xscale,1,0,c_white,tal);
      if(tptch=2){
        draw_line(448,y+319,448,y+340);
      }else if(tptch=4){
        draw_line(464,y+319,464,y+340);
      }
    }else{
      if(tptch=2){
        draw_sprite(sprVSspkup,0,304,244);
        draw_line(512,y+319,512,y+340);
      }else if(tptch=4){
        //draw_sprite(sprVSspkup,0,304,244);
        //draw_sprite(sprVSspkdown,0,304,276);
        draw_line(496,y+319,496,y+340);
      }
    }
    if(tptch=3){
      draw_sprite(sprVSspkup,0,288,244);
    }else if(tptch=4){
      draw_sprite(sprVSspkup,0,304,244);
      draw_sprite(sprVSspkdown,0,304,276);
    }
    ystimer+=1;
    if(ystimer=100)ystimer=0;
    draw_roundrect(272,224,368,384,1);
    draw_roundrect(432,224,528,384,1);
  }
  draw_set_alpha(1);
  if(al&gt;0){al-=0.01}else{lt=0};
}
if(lt){
  draw_set_color(c_white);
  draw_set_alpha(al);
  draw_rectangle(0,0,800,608,0);
  draw_set_alpha(1);
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
