    <event eventtype="2" enumb="5">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>dt=0;teach=true;
count+=1;
switch(count){
  case 1:alarm[6]=10;ntxt="Let's start.Press S to continue.";break;
  case 2:alarm[6]=50;
    tox=-32-256;toy=room_height-2816-256;toz=-192;
    ntxt="It seems that you cannot go here.";
    break;
  case 3:alarm[6]=50;
    with(objVS){change=38;todir-=pi/2;fx=-1;}
    player.frozen=true;
    px=256+112;pz=-16;
    ntxt="But in this perspective you can go here.";
    ptx=416;pty=2816;pww=64;
    break;
  case 4:alarm[6]=50;
    with(objVS){change=38;todir+=pi/2;fx=1;view_p=true;}
    tox=384-256;toy=room_height-2752-256;toz=-160;
    player.frozen=true;
    px=-32;py=2816;pz=-208;
    ntxt="Look at these two needles.";
    ptx=-64;
    break;
  case 5:alarm[6]=50;
    with(objVS){change=38;todir-=pi/2;fx=-1;}
    player.frozen=true;
    px=256+208;pz=-240;
    ntxt="In this perspective they are at the front.";
    ptx=416;
    break;
  case 6:alarm[6]=10;ntxt="If you go here,you will be killed.";
    break;
  case 7:alarm[7]=40;
    with(objVS){change=38;todir+=pi/2;fx=1;}
    player.frozen=true;
    break;
  case 8:
    alarm[6]=10;ntxt="So you can go here now.";
    ptx=64;pty=2784;
    break;
  case 9:alarm[6]=50;
    with(objVS){change=38;todir+=pi/2;fx=1;}
    tox=480-256;toz=128;toy=room_height-2784-256;
    player.frozen=true;
    px=112;py=2784;pz=176;
    ntxt="";
    ptx=0;pty=2784;
    break;
  case 10:alarm[6]=50;
    tox=-112;toy=room_height-2624-256;toz=112;
    ntxt="How to go here?";
    px=32;
    break;
  case 11:alarm[6]=10;ntxt="In this world,there are 3 axes";break;
  case 12:
    alarm[6]=10;
    ntxt="When you move to a#block,your z position#will change to its#z position";
    ntch=1;
  break;
  case 13:
    alarm[6]=10;
    ntch=2;
  break;
  case 14:
    alarm[6]=10;
    ntch=3;
  break;
  case 15:
    alarm[6]=10;
    ntch=4;
  break;
  case 16:alarm[6]=50;
    with(objVS){change=38;todir-=pi/2;fx=-1;}
    player.frozen=true;
    px=384;pz=-224;
    ntxt="Now you can go here.";
    ptx=352;pty=2624;ntch=0;
    break;
  case 17:alarm[8]=40;
    with(objVS){change=38;todir+=pi/2;fx=1;}
    player.frozen=true;
    tox=-64;toz=-192;
    break;
  case 18:alarm[6]=50;
    with(objVS){change=38;todir+=pi/2;fx=1;view_p=true;}
    tox=0;toy=room_height-2512-256;toz=-256;
    player.frozen=true;
    px=176;pz=-208;
    ntxt="This is the first cubes piece.";
    ptx=160;
    break;
  case 19:alarm[6]=10;ntxt="And there are 5 in total.";break;
  case 20:alarm[6]=10;ntxt="Collect them to restore the magic cube.";break;
  case 21:alarm[6]=10;ntxt="Use A D to change perspective.";break;
  case 22:alarm[6]=10;ntxt="Have a good trip!";break;
  case 23:
    alarm[6]=10;ntxt="";
    des=1;player.frozen=false;
    objVS.canAD=true;global.restart=true;
    break;
}
</string>
