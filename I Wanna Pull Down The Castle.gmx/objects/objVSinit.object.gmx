    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if(room=rVSInit){
  ang+=3;
  if(place_meeting(x,y,player)){
    if(change=0){
      change=1;alarm[0]=10;
    }
    with(player){
      frozen=true;speed=0;gravity=0;
    }
  }
  if(rot){
    if(a&lt;0.2)a+=0.0005;
    objVS.v_a+=a;
  }
}else{
  if(down){
    if(objVS.v_y&gt;-120){
      objVS.v_y-=4;
      objVS.v_a-=4*pi/750;
    }else{
      if(a&gt;0)a-=0.1;
      objVS.v_y-=a;
      objVS.v_a-=a*pi/750;
    }
    player.frozen=true;
  }
  if(count&gt;17 and count&lt;23){
    player.frozen=true;
  }
  if(des){
    image_alpha-=0.1;
    if(image_alpha&lt;0)instance_destroy();
  }
  dx+=(tox-dx)/20;
  dy+=(toy-dy)/20;
  dz+=(toz-dz)/20;
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
