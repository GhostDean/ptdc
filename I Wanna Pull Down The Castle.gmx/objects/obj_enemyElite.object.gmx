    || object_get_parent(object_index) == obj_skeletonWarrior
    || object_index == obj_rifler
    || object_index == obj_shielder draw_rectangle_colour(x,y-rectOffsetY,x+rectWidth*image_xscale,y-rectOffsetY+rectHeight,c_red,c_red,c_red,c_red,1);
}
