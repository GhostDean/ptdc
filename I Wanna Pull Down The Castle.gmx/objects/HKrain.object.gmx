        <arguments>
          <argument>
            <kind>1</kind>
            <string>ps=part_system_create();//creates a new particle system
em=part_emitter_create(ps);//creates a new particle emitter

part_emitter_region(ps,em,0,room_width,0,0,ps_shape_rectangle,ps_distr_linear);//sets the emitters region to just above the area you can see

rn=part_type_create();//creates a new particle type
part_type_alpha2(rn,1,0.1);//sets the alpha of the new particle
part_type_blend(rn,true);//sets the blending of the new particle
part_type_color2(rn,c_aqua,c_white);//sets the color of the new particle
part_type_direction(rn,265,275,0,0);//sets the direction of the new particle
part_type_life(rn,150,200);//sets the life of the new particle
part_type_orientation(rn,0,0,0,0,true);//sets the angle of the new particle
part_type_shape(rn,pt_shape_line);//sets the shape of the new particle
part_type_size(rn,0.1,0.2,0,0);//sets the size of the new particle
part_type_speed(rn,7,15,0.05,0);//sets the speed of the new particle
part_system_depth(rn,1000005)

sp=part_type_create();//creates a new particle type
part_type_alpha2(sp,1,0);//sets the alpha of the new particle
part_type_blend(sp,true);//sets the blending of the new particle
part_type_color1(sp,make_color_rgb(25,25,255));//sets the color of the new particle
part_type_direction(sp,0,360,0,0);//sets the direction of the new particle
part_type_gravity(sp,0.25,270);//sets the gravity of the new particle
part_type_life(sp,50,50);//sets the life of the new particle
part_type_orientation(rn,0,0,0,0,true);//sets the angle of the new particle
part_type_shape(sp,pt_shape_sphere);//sets the shape of the new particle
part_type_size(sp,0.1,0.1,-0.0001,0);//sets the size of the new particle
part_type_speed(sp,2,5,0.05,0);//sets the speed of the new particle
part_system_depth(sp,1000005)
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
