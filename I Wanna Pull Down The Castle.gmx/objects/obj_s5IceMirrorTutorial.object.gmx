        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>// update animation
playerTimer++;
if playerTimer == 5
{
    playerTimer = 0;
    playerIdx = (playerIdx + 1) mod 4;
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
