        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if !triggered exit;

// draw rect
draw_set_alpha(rectAlp);
draw_set_colour(c_black);
draw_rectangle(0, 0, 800, 608, 0);
draw_set_colour(c_white);
draw_set_alpha(1);
// draw text
draw_set_alpha(alp);
draw_set_font(fntPixel60);
draw_set_halign(1);
draw_set_valign(1);
draw_text(400, 100, 'Tutorial');
draw_set_halign(0);
draw_set_valign(0);
draw_set_font(fDefault12);
draw_set_alpha(1);
// draw etcs
draw_sprite_ext(sprPressZKey, zKeyIdx, 500, 140, 1, 1, 0, c_white, alp);
draw_sprite_ext(sprS6icemD, 0, 400, 150, 1, 1, 0, c_white, alp);
if bulletAppear draw_sprite_ext(sprS6iceb, 0, bulletX, bulletY, 1, 1, 0, c_white, 1);
draw_sprite_ext(sprPlayerIdle, playerIdx, 500, 175, -1, 1, 0, c_white, alp);
var _waterSpr = sprWater;
if bulletHit _waterSpr = sprite390_ice;
draw_sprite_ext(_waterSpr, 0, 400, 250, 1, 1, 0, c_white, alp);
</string>
          </argument>
        </arguments>
      </action>
    </event>
