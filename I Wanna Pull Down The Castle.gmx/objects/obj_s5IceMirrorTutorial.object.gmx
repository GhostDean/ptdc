kind = 0;
triggered = false;
timer = 0;

rectAlp = 0;
alp = 0;

bulletAppear = false;
bulletHit = false;
bulletX = 500 - 17;
bulletY = 175;

playerIdx = 0;
playerTimer = 0;
zKeyIdx = 0;
</string>
