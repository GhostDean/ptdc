            <kind>1</kind>
            <string>//calculating views according to playerIr position

switch(kind){
    case -2:
        {
            if(instance_exists(playerIr)){
                if(!only){
                    view_xview[0] = max(0,min(playerIr.x - view_wview[0] / 2,room_width - view_wview[0]));
                    view_yview[0] = max(0,min(playerIr.y - view_hview[0] / 2,room_height - view_hview[0]));
                }
                else{
                    view_xview[0] = max(0,min(playerIr.x - view_wview[0] / 2,room_width - view_wview[0]),view_xview[0]);
                    view_yview[0] = max(0,min(playerIr.y - view_hview[0] / 2,room_height - view_hview[0]),view_yview[0]);
                }
            }break;
        }
    case -1:
        {
            if(instance_exists(playerIr)){
                if(!only){
                    view_xview[0] = max(0,min(playerIr.x - view_wview[0] / 2,room_width - view_wview[0]));
                }
                else{
                    view_xview[0] = max(0,min(playerIr.x - view_wview[0] / 2,room_width - view_wview[0]),view_xview[0]);
                }
            }break;
        }
    default:
        {
            if(instance_exists(playerIr)){
                if(playerIr.x - (view_xview[0] + view_wview[0]) &gt; -128){
                    view_xview[0] = max(0,min(view_xview[0] + max(playerIr.hspeed,kind),room_width - view_wview[0]));
                }
                else{
                    view_xview[0] = max(0,min(view_xview[0] + kind,room_width - view_wview[0]));
                }
            }break;
        }
}
view_xview[0]=floor(view_xview[0]);
</string>
          </argument>
        </arguments>
      </action>
