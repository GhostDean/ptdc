    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>gravity=0.4;
if(frozen){
  hspeed=0;
}else{
  if(keyboard_check(vk_left)){
    hspeed=-hspd;
    image_xscale=-1;
  }else if(keyboard_check(vk_right)){
    hspeed=hspd;
    image_xscale=1;
  }else{
    hspeed=0;
  }
}
if(vspeed&gt;0.5){
  sprite_index=sprPlayerFall;
}
if(!place_free(x,y+1)){
  if(hspeed=0){
    sprite_index=sprPlayerIdle;
  }else{
    sprite_index=sprPlayerRunning;
  }
}
if(!frozen){
  if(!place_meeting(x,y,objVSwater)){
    inwater=false;
  }
  if(keyboard_check_pressed(vk_shift)){
  if(!place_free(x,y+1)){
    vspeed=jump1;
    sprite_index=sprPlayerJump;
    audio_sound_pitch(sndJump,1);
    audio_play_sound(sndJump,2,0);
  }else if(djump=true or inwater){
    vspeed=jump2;
    sprite_index=sprPlayerJump;
    djump=false;
    audio_sound_pitch(sndJump,2);
    audio_play_sound(sndJump,2,0);
  }
  }
}
if(keyboard_check_released(vk_shift)){
  if(vspeed&lt;0)vspeed*=0.45;
}
if(vspeed&gt;maxvspd)vspeed=maxvspd;
if(place_meeting(x,y,playerKiller)){
  var a;
  a=instance_create(x,y,objVSdeadplayer);
  a.sprite_index=sprite_index;
  a.image_xscale=image_xscale;
  a.image_single=image_index;
  global.death+=1;
  audio_play_sound(sndDeath,2,0);
  instance_destroy();
}
if(instance_exists(objVS)){
  if(y&gt;room_height+160){
    var a;
    repeat(16){
      a=instance_create(x,y,objVSblood);
      a.y=room_height-y-256;
      switch(objVS.xz){
        case 0:
          a.x=x-room_width/2;
          a.z=z;
        break;
        case 1:
          a.z=x-room_width/2;
          a.x=-z;
        break;
        case 2:
          a.x=room_width/2-x;
          a.z=-z;
        break;
        case 3:
          a.x=z;
          a.z=room_width/2-x;
        break;
      }
    }
    global.death+=1;
    audio_play_sound(sndDeath,2,0);
    instance_destroy();
  }
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
