        <arguments>
          <argument>
            <kind>1</kind>
            <string>if hp &gt; 0
{
    if !active
    {
        if !patrol
        {
            hspeed = 0;
            scrChangeImage(sprShielderIdle, .2);
        }
        active = scrPlayerInRectangle(x,y-rectOffsetY,rectWidth*image_xscale,rectHeight);
    }
    else
    {
        if patrol patrol = 0;
        if hspeed != 0 hspeed = 0;
        scrFollowPlayerDirecton();
        if !attacking
        {
            attacking = 1;
            scrChangeImage(sprShielderAttackReady, .2);
        }
        else
        {
            if sprite_index == sprShielderAttack &amp;&amp; !shot
            {
                shot = 1;
                with instance_create(x+39*image_xscale,y-50,obj_shielderBullet)
                {
                    if instance_exists(objPlayer) direction = point_direction(x,y,objPlayer.x,objPlayer.y);
                    speed = 12;
                }
            }
        }
    }
}
</string>
