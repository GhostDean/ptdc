        <arguments>
          <argument>
            <kind>1</kind>
            <string>if hp == 0 return -1;
if damaged return -1;

if !active
{
    if patrol
    {
        if sprite_index != skArcherWalk
        {
            if hspeed = 0 hspeed = moveSpeed * image_xscale;
            scrChangeImage(skArcherWalk, .3);
        }
    }
    active = scrPlayerInRectangle(x,y-rectOffsetY,rectWidth*image_xscale,rectHeight);
    if !active
    {
        if patrol return -1;
        scrChangeImage(skArcherIdle, .2);
    }
}
else
{
    scrFollowPlayerDirecton();
    image_xscale = sign(image_xscale) * 1.5;
    if sprite_index != skArcherAttack
    {
        hspeed = 0;
        scrChangeImage(skArcherAttack, .6);
    }
    else
    {
        if (image_index &gt;= 9 &amp;&amp; image_index &lt; 10) &amp;&amp; !shot
        {
            with instance_create(x+25*sign(image_xscale),y-31,obj_skArcherArrow)
            {
                image_xscale = other.image_xscale;
                direction = point_direction(x,y,objPlayer.x,objPlayer.y);
                speed = 24;
                sprite_index = other.skArcherArrow;
                image_angle = 180 + direction;
                shadow = 1;
            }
            shot = 1;
        }
    }
}
</string>
