  d3d_model_floor(objVS.watermod,dx+32*xs,-dy,dz+32*zs,dx+32*xs,-dy-32*ys,dz,1,1);
}
spkmod=d3d_model_create();
with(objVS3dspk){
  if(down){
    d3d_model_cone(objVS.spkmod,dx+32,-dz-32,-dy,dx,-dz,-dy-32,1,1,0,12);
  }else{
    d3d_model_cone(objVS.spkmod,dx,-dz-32,-dy-32,dx+32,-dz,-dy,1,1,0,12);
  }
}
