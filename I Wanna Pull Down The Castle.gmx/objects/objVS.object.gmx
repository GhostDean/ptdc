xxx=0;yyy=0;

var i,xs,ys;
if(room=rVS01){
  for(i=20;i&gt;-1;i--){
    cloud_range[i]=random_range(1000,1500);
    xs=random_range(50,150);
    ys=random_range(25,xs);
    cloud_x1[i]=irandom(800)-xs;
    cloud_y1[i]=irandom(cloud_range[i])-ys;
    cloud_x2[i]=cloud_x1[i]+xs*2;
    cloud_y2[i]=cloud_y1[i]+ys*2;
    cloud_a[i]=random_range(0.3,0.6);
    cloud_range[i]=(cloud_range[i]-608)/(room_height-608);
  }
  for(i=30;i&gt;-1;i--){
    xs=choose(1,1.5);
    star_x1[i]=irandom(800)-xs;
    star_y1[i]=irandom(608)-xs;
    star_x2[i]=star_x1[i]+xs;
    star_y2[i]=star_y1[i]+xs;
    star_t[i]=random_range(0.01,0.02);
    star_f[i]=random_range(0,pi*2);
    star_a[i]=random_range(0.2,0.3);
  }
}else{
  for(i=5;i&gt;-1;i--){
    xs=random_range(50,150);
    ys=random_range(25,xs);
    cloud_x1[i]=irandom(800)-xs;
    cloud_y1[i]=irandom(608)-ys;
    cloud_x2[i]=cloud_x1[i]+xs*2;
    cloud_y2[i]=cloud_y1[i]+ys*2;
    cloud_a[i]=random_range(0.3,0.6);
  }
  front_tex=sprite_get_texture(sprVSroomf,0);
  back_tex=sprite_get_texture(sprVSroomf,1);
  left_tex=sprite_get_texture(sprVSrooms,0);
  right_tex=sprite_get_texture(sprVSrooms,1);
}

ccang=0;tocube=0;
up_view=0;
