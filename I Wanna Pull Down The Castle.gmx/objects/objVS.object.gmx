  var i,draw_y;
  if(global.bktimer&gt;3500 and global.bktimer&lt;5800){
    var sal;
    for(i=30;i&gt;-1;i--){
      sal=min((global.bktimer-3500)/500,(sin(star_f[i])+2)*star_a[i],(5800-global.bktimer)/500);
      star_f[i]+=star_t[i];
      draw_set_alpha(sal);
      draw_rectangle(star_x1[i],star_y1[i],star_x2[i],star_y2[i],0);
    }
  }
  for(i=20;i&gt;-1;i--){
