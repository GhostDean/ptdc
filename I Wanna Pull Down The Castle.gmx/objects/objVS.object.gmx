        <arguments>
          <argument>
            <kind>1</kind>
            <string>if(view_p){
  ep=instance_exists(player);
  if(room=rVS01){
    if(ep){
      if(up_view){
        if(to_vy&lt;2656)to_vy+=4;
        if(to_vy&gt;2656)to_vy=2656;
      }else{
        to_vy=ceil(room_height-player.y-256);
      }
      if(player.y&lt;60 and player.x&gt;252 and player.x&lt;260){
        if(canAD){
          player.frozen=true;canAD=false;
          alarm[1]=40;
        }
      }
    }
  }
  var spd=(to_vy-v_y)/20;
  v_y+=max(1,abs(spd))*sign(spd);
  if(abs(to_vy-v_y)&lt;1)v_y=to_vy;
  if(up_view){
    if(v_y=2656){
      //End
    }
  }
}
