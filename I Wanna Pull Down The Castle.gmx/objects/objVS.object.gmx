        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if(instance_exists(player)){
  instance_deactivate_object(objVS3dblock);
  instance_deactivate_object(objVS3dspk);
  instance_activate_region(-144,player.y-50,800,100,1);
  instance_activate_object(objVS3dvblk);
  player.visible=false;
}
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if(room=rVS01){
  ep=instance_exists(player);
  if(change){
    if(ep){
      player.frozen=true;
      player.speed=0;
      player.gravity=0;
    }
    if(change=38){
      wtxz+=fx;if(wtxz&gt;3)wtxz=0;if(wtxz&lt;0)wtxz=3;
      switch(wtxz){
        case 0:with(objVSwater)nz=dz;break;
        case 1:with(objVSwater)nz=-dx-xs*32;break;
        case 2:with(objVSwater)nz=-dz-zs*32;break;
        case 3:with(objVSwater)nz=dx;break;
      }
    }
    change-=1;
    v_a+=fx*min(0.1,max(abs(todir-v_a)/10,0.01));
    if(change=0){
      v_a=todir;
      xz+=fx;if(xz&gt;3)xz=0;if(xz&lt;0)xz=3;
      if(ep){
        player.frozen=false;
        if(fx=1){
          var px=floor((player.x-room_width/2)/32)*32+16;
          player.x=player.z+room_width/2;
          player.z=-px;
        }else{
          var px=floor((player.x-room_width/2)/32)*32+16;
          player.x=-player.z+room_width/2;
          player.z=px;
        }
        player.y-=player.gravity;
      }
      instance_activate_object(objVS3dblock);
      instance_activate_object(objVS3dspk);
      switch(xz){
        case 0:
          with(objVS3dblock){
            x=room_width/2+dx;z=dz;
            image_xscale=xs;nzs=zs;
          }
          with(objVSwater){
            x=room_width/2+dx;z=dz;
            image_xscale=xs;nzs=zs;
          }
          with(objVS3dspk){
            x=room_width/2+dx;z=dz;
          }
          with(objVScc){
            x=room_width/2+dx;z=dz;
          }
        break;
        case 1:
          with(objVS3dblock){
            x=room_width/2+dz;z=-dx-xs*32;
            image_xscale=zs;nzs=xs;
          }
          with(objVSwater){
            x=room_width/2+dz;z=-dx-xs*32;
            image_xscale=zs;nzs=xs;
          }
          with(objVS3dspk){
            x=room_width/2+dz;z=-dx-32;
          }
          with(objVScc){
            x=room_width/2+dz;z=-dx;
          }
        break;
        case 2:
          with(objVS3dblock){
            x=room_width/2-dx-xs*32;z=-dz-zs*32;
            image_xscale=xs;nzs=zs;
          }
          with(objVSwater){
            x=room_width/2-dx-xs*32;z=-dz-zs*32;
            image_xscale=xs;nzs=zs;
          }
          with(objVS3dspk){
            x=room_width/2-dx-32;z=-dz-32;
          }
          with(objVScc){
            x=room_width/2-dx;z=-dz;
          }
        break;
        case 3:
          with(objVS3dblock){
            x=room_width/2-dz-zs*32;z=dx;
            image_xscale=zs;nzs=xs;
          }
          with(objVSwater){
            x=room_width/2-dz-zs*32;z=dx;
            image_xscale=zs;nzs=xs;
          }
          with(objVS3dspk){
            x=room_width/2-dz-32;z=dx;
          }
          with(objVScc){
            x=room_width/2-dz;z=dx;
          }
        break;
      }
      instance_deactivate_object(objVS3dblock);
      instance_deactivate_object(objVS3dspk);
      if(instance_exists(player)){
        instance_activate_region(-144,player.y-50,800,100,1);
      }
      instance_activate_object(objVS3dvblk);
    }
  }else{
    if(canAD and ((ep and player.sprite_index=sprPlayerIdle and player.frozen=false) or ep=0)){
      if(keyboard_check_pressed(ord("A"))){
        change=38;todir-=pi/2;fx=-1;
      }else if(keyboard_check_pressed(ord("D"))){
        change=38;todir+=pi/2;fx=1;
      }
    }
  }
  if(ep and change=0){
    with(player){
      var vx,vy;
      vy=y+vspeed+gravity;
      vx=x+hspeed;
      if(vspeed+gravity&gt;=0){
      if(place_meeting(vx,vy,objVS3dblock)){
        var by=floor(y/32)*32+32,zz=1000,nc=0,zd=1000;
        with(objVS3dblock){
          if(x-5&lt;vx and x+5+32*image_xscale&gt;vx){
            if(y=by){
              if(z&lt;player.z and z+32*nzs&gt;player.z){
                nc=1;break;
              }else if(player.y&lt;y-8){zz=min(zz,z+16)}
            }else if(y&lt;vy+9 and y+32*ys&gt;vy-12){
                zd=min(zd,z);
            }
          }
        }
        if(zz!=1000 and nc=0 and (player.z&lt;zd and zz&lt;zd))player.z=zz;
      }
      }
    }
    with(objVS3dblock){
      solid=(z&lt;player.z and z+32*nzs&gt;player.z)
    }
    with(objVSwater){
      water=(z&lt;player.z and z+32*nzs&gt;player.z)
    }
    with(objVS3dspk){
      kill=(z&lt;player.z and z+32&gt;player.z)
    }
    with(objVScc){
      pz=(z-12&lt;player.z and z+12&gt;player.z)
    }
  }
}
v_x=v_r*cos(v_a);
v_z=v_r*sin(v_a);
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>//background
if(room=rVS01){
  global.bktimer+=1;
  if(global.bktimer&gt;1999 and global.bktimer&lt;2500){
    global.val-=0.1;
  }else if(global.bktimer&gt;2499 and global.bktimer&lt;3500){
    global.val-=0.07;
    global.hue+=0.08;
    if(global.bktimer&gt;2499 and global.bktimer&lt;3000){
      global.sat-=0.05;
    }else{
      global.sat+=0.05;
    }
  }else if(global.bktimer&gt;3499 and global.bktimer&lt;4000){
    global.val-=0.07;
  }else if(global.bktimer&gt;5499 and global.bktimer&lt;6500){
    if(global.bktimer&gt;5499 and global.bktimer&lt;5800){
      global.val+=0.3;
      global.hue+=0.17;
    }else if(global.bktimer&gt;5799 and global.bktimer&lt;6000){
      global.val+=0.15;
      global.hue+=0.05;
    }else{
      global.val+=0.03;
      if(global.bktimer&gt;5999 and global.bktimer&lt;6200){
        global.sat-=0.5;
      }
      global.hue+=0.226;
    }
    if(global.hue&gt;255)global.hue-=255;
  }else if(global.bktimer&gt;6499 and global.bktimer&lt;7000){
    global.val+=0.04;global.sat+=0.2;
  }else if(global.bktimer=7000){
    global.bktimer=0;
  }
}
