rockmod[2]=d3d_model_create();
rockmod[1]=d3d_model_create();
rockmod[0]=d3d_model_create();
player.visible=false;
with(objVS3dblock){
  if(!vis){
    var xx,yy,zz;
    for(yy=dy;yy&lt;dy+32*ys;yy+=32){
      for(xx=dx;xx&lt;dx+32*xs;xx+=32){
        if(yy=dy and gr){
          if(rock){
            d3d_model_floor(objVS.rockmod[choose(2,3)],xx+32,-yy,dz,xx,-yy-32,dz,1,1);
            d3d_model_floor(objVS.rockmod[choose(2,3)],xx,-yy,dz+32*zs,xx+32,-yy-32,dz+32*zs,1,1);
          }else{
            d3d_model_floor(objVS.grassmod[choose(0,1,2,3)],xx+32,-yy,dz,xx,-yy-32,dz,1,1);
            d3d_model_floor(objVS.grassmod[choose(0,1,2,3)],xx,-yy,dz+32*zs,xx+32,-yy-32,dz+32*zs,1,1);
          }
        }else{
          if(rock){
            d3d_model_floor(objVS.rockmod[choose(0,1)],xx+32,-yy,dz,xx,-yy-32,dz,1,1);
            d3d_model_floor(objVS.rockmod[choose(0,1)],xx,-yy,dz+32*zs,xx+32,-yy-32,dz+32*zs,1,1);
          }else{
            d3d_model_floor(objVS.blockmod[choose(0,1,2,3)],xx+32,-yy,dz,xx,-yy-32,dz,1,1);
            d3d_model_floor(objVS.blockmod[choose(0,1,2,3)],xx,-yy,dz+32*zs,xx+32,-yy-32,dz+32*zs,1,1);
          }
        }
      }
      for(zz=dz;zz&lt;dz+32*zs;zz+=32){
        if(yy=dy and gr){
          if(rock){
            d3d_model_floor(objVS.rockmod[choose(2,3)],dx,-yy,zz,dx,-yy-32,zz+32,1,1);
            d3d_model_floor(objVS.rockmod[choose(2,3)],dx+32*xs,-yy,zz+32,dx+32*xs,-yy-32,zz,1,1);
          }else{
            d3d_model_floor(objVS.grassmod[choose(0,1,2,3)],dx,-yy,zz,dx,-yy-32,zz+32,1,1);
            d3d_model_floor(objVS.grassmod[choose(0,1,2,3)],dx+32*xs,-yy,zz+32,dx+32*xs,-yy-32,zz,1,1);
          }
        }else{
          if(rock){
            d3d_model_floor(objVS.rockmod[choose(0,1)],dx,-yy,zz,dx,-yy-32,zz+32,1,1);
            d3d_model_floor(objVS.rockmod[choose(0,1)],dx+32*xs,-yy,zz+32,dx+32*xs,-yy-32,zz,1,1);
          }else{
            d3d_model_floor(objVS.blockmod[choose(0,1,2,3)],dx,-yy,zz,dx,-yy-32,zz+32,1,1);
            d3d_model_floor(objVS.blockmod[choose(0,1,2,3)],dx+32*xs,-yy,zz+32,dx+32*xs,-yy-32,zz,1,1);
          }
        }
      }
    }
  }
}
watermod=d3d_model_create();
watercol=make_color_rgb(30,144,255);
with(objVSwater){
  d3d_model_floor(objVS.watermod,dx+32*xs,-dy,dz,dx,-dy-32*ys,dz,1,1);
  d3d_model_floor(objVS.watermod,dx,-dy,dz+32*zs,dx+32*xs,-dy-32*ys,dz+32*zs,1,1);
