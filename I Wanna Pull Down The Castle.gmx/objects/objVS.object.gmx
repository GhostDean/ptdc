    <event eventtype="8" enumb="64">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>d3d_set_projection_ortho(0,0,800,608,0);
d3d_set_hidden(0);

draw_set_alpha((255-global.val)/400);
draw_set_color(c_black);
draw_rectangle(0,0,800,608,0);
draw_set_alpha(1);

if(tocube){
  var cbx,cby;
  cbx=ccid.x+144;cby=v_y-ccid.dy+304;
  var ag;
  draw_set_color(c_white);
  draw_set_alpha(0.5);
  for(ag=global.vsbk;ag&lt;global.vsbk+360;ag+=60){
    draw_triangle(cbx,cby,cbx+lengthdir_x(tocube,ag),cby+lengthdir_y(tocube,ag),
    cbx+lengthdir_x(tocube,ag+20),cby+lengthdir_y(tocube,ag+20),0);
  }
  if(tocube&lt;1000)tocube+=10;
  if(tocube&gt;500){
    draw_set_alpha((tocube-500)/500);
    draw_rectangle(0,0,800,608,0);
  }
  draw_set_alpha(1);
  global.vsbk-=0.5;
  if(global.vsbk&lt;0)global.vsbk+=360;
}
