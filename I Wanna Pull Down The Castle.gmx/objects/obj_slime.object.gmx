            <string>if hp == 0 return -1;
if damaged return -1;
if !active
{
    scrChangeImage(slimeIdle, .1);
    if !wander &amp;&amp; hspeed != 0
    {
        hspeed = 0;
    }
    var _dist = scrPlayerDistance();
    if _dist &lt;= radius active = 1;
}
else
{
    if wander wander = false;
    if instance_exists(objPlayer)
    {
        scrFollowPlayerDirecton();
        scrBasicEnemyMovement(moveSpeed);
        if sprite_index != slimeWalk
        {
            sprite_index = slimeWalk;
            image_speed = .2;
        }
    }
}
</string>
