        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if shootmode &gt; 0
{
    var _arrowSpr = sprS2RA;
    if shootmode == 2
    {
        _arrowSpr = sprS2GA;
    }
    else if shootmode == 3
    {
        _arrowSpr = sprS2BA;
    }
    
    draw_sprite_ext(_arrowSpr, 0, 726, 88, 1, 1, 0, c_white, displayArrowNumAlpha);
    draw_set_alpha(displayArrowNumAlpha);
    draw_set_colour(c_white);
    draw_set_font(fntPixel20);
    draw_set_halign(1);
    draw_set_valign(1);
    draw_text(726+((800-706)&gt;&gt;1), 92, 'X');
    draw_set_halign(fa_right);
    draw_set_valign(fa_top);
    draw_text(795, 78, string(arrow[shootmode - 1]));
    draw_set_halign(fa_left);
    draw_set_font(fDefault12);
    draw_set_alpha(1);
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///draw the player

var drawX = x;
var drawY = y;

if (global.grav == -1)      //need to draw the player a pixel off in the y-axis when flipped for some reason
    drawY += 1;

if(shootmode){
    draw_sprite_ext(sprS2Bow,0,drawX,drawY,image_xscale*xScale,image_yscale*global.grav,image_angle,image_blend,image_alpha);
    if(arrow[shootmode-1]){
        switch(shootmode){
            case 1:var spr=sprS2RA;break;
            case 2:var spr=sprS2GA;break;
            case 3:var spr=sprS2BA;break;
        }
        draw_sprite_ext(spr,displayArrowIndex,drawX,drawY-7,image_xscale*xScale,image_yscale*global.grav,image_angle,image_blend,image_alpha);
    }
}

if inGettingItem &amp;&amp; sprite_exists(gottenItemSpr)
{
    draw_sprite_ext(gottenItemSpr, 0, x - 1 + gottenItemOffX, y - gottenItemOffset + gottenItemOffY, 1, 1, 0, c_white, gottenItemAlpha);
}

draw_sprite_ext(sprite_index,image_index,drawX,drawY,image_xscale*xScale,image_yscale*global.grav,image_angle,image_blend,image_alpha);

//draw the player's hitbox
if (global.debugShowHitbox)
    draw_sprite_ext(mask_index,image_index,x,y,image_xscale,image_yscale,image_angle,image_blend,image_alpha*0.8);
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// oxygen bar
if oxygenShow
{
    draw_healthbar(x-20, y-30, x+20, y-25, (oxygenTimer / oxygenTime) * 100, 0, c_green, c_green, 0, 0, 1);
}
</string>
          </argument>
        </arguments>
      </action>
