      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Other
// arrow display
if shootmode &gt; 0
{
    if displayArrowTimer == 0
    {
        displayArrowTimer = 30;
        displayArrowIndex = (displayArrowIndex + 1) mod 3;
    }
    else
    {
        displayArrowTimer--;
    }
    if displayArrowNumAlpha &lt; 1
    {
        displayArrowNumAlpha += .1;
    }
}
else
{
    if displayArrowTimer != 30
    {
        displayArrowTimer = 30;
    }
    if displayArrowIndex != 0
    {
        displayArrowIndex = 0;
    }
    if displayArrowNumAlpha &gt; 0
    {
        displayArrowNumAlpha -= .1;
    }
}
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Vine(Rope)
var v=instance_place(x,y,objS9Vine)
if(v!=noone){
    if(!onVine){
        onVine=1;
        if(v.fall){
            v.alarm[0]=v.fallTime;v.fall=false;
        }
    }
    if(onVine==1){
        x=v.x;hspeed=0;gravity=0;
        sprite_index=sprPlayerBack;
        vspeed=scrButtonCheck(global.downButton)-scrButtonCheck(global.upButton)&lt;&lt;1;
        if(scrButtonCheckPressed(global.jumpButton)){
            onVine=2;djump=1;
            gravity=0.4*global.grav;
            scrPlayerJump();
        }
    }
}else if(onVine){
    onVine=0;
    gravity=0.4*global.grav;
}
</string>
          </argument>
        </arguments>
