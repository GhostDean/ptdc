        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Draw kid
if inView
{
    if scrCheckPlayerExists()
    {
        with objPlayer
        {
            draw_sprite_ext(sprite_index, image_index, x-800*(x div 800), y, xScale, image_yscale, image_angle, image_blend, image_alpha);
        }
    }
}
</string>
