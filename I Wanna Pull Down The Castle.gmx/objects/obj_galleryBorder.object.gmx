    <event eventtype="8" enumb="64">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if inView
{
    var _offset = x - view_xview[0];
    if kind &lt; 2 &amp;&amp; surface_exists(surfPortrait) &amp;&amp; createLightCount &lt; 30
    {
        draw_surface(surfPortrait, _offset+14, y+17);
        if twistEnable
        {
            shader_set(shdTwist);
            shader_set_uniform_f(uni_radius, radius);
            shader_set_uniform_f(uni_angle, angle);
            shader_set_uniform_f_array(uni_centerPoint, centerPoint);
            shader_set_uniform_f_array(uni_filterArea, filterData);
            draw_surface_ext(surfPortrait, _offset+14, y+17, 1, 1, 0, c_white, surfPortraitAlpha);
            shader_reset();
        }
        if kind &gt; 0 &amp;&amp; kind &lt; 2 &amp;&amp; createLightCount &lt; 30
        {
            draw_set_alpha(.1);
            draw_set_colour(c_black);
            var _width = 285;
            var _height = 184;
            var _rectx = _offset + 14 + blackRectOffset;
            var _recty = y + 17 + blackRectOffset;
            draw_rectangle(_rectx, _recty, _rectx+_width-blackRectOffset*2, _recty+_height-blackRectOffset*2, 0);
            draw_set_alpha(1);
            draw_set_colour(c_white);
        }
    }
    draw_sprite_ext(sprGalleryTransitionWarp, 0, _offset+14+285/2, y+17+92, blackWarpScale, blackWarpScale, blackWarpAngle, c_black, blackWarpAlpha);
    draw_sprite_ext(sprite_index, image_index, _offset, y, image_xscale, image_yscale, 0, c_white, image_alpha);
    if kind &gt;= 1
    {
        // draw surface
        if createLightCount &gt;= 10
        {
            draw_surface_ext(surfTransition, 0, 0, 1, 1, 0, c_white, transitionAlpha);
        }
    }
}

if screenAlpha &gt; 0
{
    draw_set_alpha(screenAlpha);
    draw_set_colour(c_white);
    draw_rectangle(0, 0, 800, 608, 0);
    draw_set_alpha(1);
}
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
