    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>surfPortrait = surface_create(285, 184);
surfTransition = surface_create(800, 608);
surfTransitionMask = surface_create(800, 608);
surfWarpGraphic = surface_create(800, 608);

inView = false;
kind = -1;

waitTimer = 0;

// white screen flash
screenAlpha = 0;
// black rectangle
blackRectOffset = 0;
blackRectKind = 0;
// create dark light
createLightCount = 0;
createLightTimer = 0;
// twist shader
twistEnable = 1;
// portrait surface
// do initialization
// draw stage preview to surface
surface_set_target(surfPortrait);
draw_sprite_ext(sprGallerySLPreview, 0, 200, 184/2, .9, .9, 0, c_white, 1);
surface_reset_target();
surfPortraitAlpha = .5;
// preview warp surface
surface_set_target(surfWarpGraphic);
draw_set_blend_mode_ext(bm_inv_dest_alpha, bm_dest_alpha);
for (var i = 0; i &lt; 30; i++)
{
    draw_sprite_ext(sprGallerySLPreview, 0, x+220+14-800*(x div 800), y+17+92, .9+0.1*i, .9+0.1*i, 1*i, c_white, 1);
}
draw_set_blend_mode(bm_normal);
surface_reset_target();
warpSurfaceScale = 1;
// gradient
gradientScale = 0;
// black background
blackWarpAlpha = 0;
blackWarpScale = 18;
blackWarpAngle = 0;
blackBGWidth = 285;
blackBGHeight = 184;
blackBGIncrement = 0;
// transparent mask
maskRadius = 200;
maskRectWidth = 285;
maskRectHeight = 184;
maskRectIncrement = 0;
// transition
transitionAlpha = 0;
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Shader Initialization
// get shader uniforms
var _shader = shdTwist;
uni_radius = shader_get_uniform(_shader, 'radius');
uni_angle = shader_get_uniform(_shader, 'angle');
uni_centerPoint = shader_get_uniform(_shader, 'offset');
uni_filterArea = shader_get_uniform(_shader, 'filterArea');

// set shader vars
radius = 180;
angle = 0;
centerPoint[0] = 285 / 2;// x
centerPoint[1] = 184 / 2;// y
filterData[0] = 285;
filterData[1] = 184;
filterData[2] = 0;
filterData[3] = 0;
// set related var
angleTimer = 0;
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="1" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>scrFreeSurface(surfPortrait);
scrFreeSurface(surfTransition);
scrFreeSurface(surfTransitionMask);
scrFreeSurface(surfWarpGraphic);
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="2">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Surface
if inView
{
    var _offset = x - view_xview[0];
    if kind &lt; 2 &amp;&amp; !surface_exists(surfPortrait)
    {
        surfPortrait = surface_create(285, 184);
        // draw stage preview to surface
        surface_set_target(surfPortrait);
        draw_sprite_ext(sprGallerySLPreview, 0, 200, 184/2, .9, .9, 0, c_white, 1);
        surface_reset_target();
    }
    if kind &gt;= 1 &amp;&amp; createLightCount &gt;= 10
    {
        if !surface_exists(surfWarpGraphic)
        {
            surfWarpGraphic = surface_create(800, 608);
            surface_set_target(surfWarpGraphic);
            draw_set_blend_mode_ext(bm_inv_dest_alpha, bm_dest_alpha);
            for (var i = 0; i &lt; 30; i++)
            {
                draw_sprite_ext(sprGallerySLPreview, 0, x+220+14-800*(x div 800), y+17+92, .9+0.1*i, .9+0.1*i, 1*i, c_white, 1);
            }
            draw_set_blend_mode(bm_normal);
            surface_reset_target();
        }
        if !surface_exists(surfTransition)
        {
            surfTransition = surface_create(800, 608);
        }
        if !surface_exists(surfTransitionMask)
        {
            surfTransitionMask = surface_create(800, 608);
        }
        // draw mask surface first
        surface_set_target(surfTransitionMask);
        draw_clear_alpha(c_black, 0);
        draw_set_alpha(1);
        draw_set_colour(c_white);
        draw_circle(x+150+14, y+17+92, maskRadius, 0);
        surface_reset_target();
        // draw actual transition
        surface_set_target(surfTransition);
        draw_clear_alpha(c_black, 0);
        draw_surface_center_ext(surfWarpGraphic, 400, 304, warpSurfaceScale, warpSurfaceScale, 0, c_white, 1);
        draw_set_blend_mode_ext(bm_zero, bm_src_alpha);
        draw_surface(surfTransitionMask, 0, 0);
        draw_set_blend_mode(bm_normal);
        surface_reset_target();
    }
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Do Transition Animation
switch kind
{
    case 0:
        if screenAlpha &gt; 0
        {
            screenAlpha -= .1;
        }
        else
        {
            kind = 1;
        }
        break;
    case 1:
        if createLightCount &lt; 5
        {
            if createLightTimer == 0
            {
                createLightCount++;
                createLightTimer = 10;
                var inst = instance_create(x+285/2, y+184/2, obj_galleryLight);
                inst.dir = random(360);
            }
            else
            {
                createLightTimer--;
            }
        }
        else if createLightCount &lt; 40
        {
            if createLightCount &gt;= 10 &amp;&amp; createLightCount &lt; 30
            {
                if blackWarpAlpha &lt; 1
                {
                    blackWarpAlpha += .01;
                }
                if transitionAlpha &lt; 1
                {
                    transitionAlpha += .01;
                }
                if surfPortraitAlpha &gt; 0
                {
                    surfPortraitAlpha -= .01;
                    if surfPortraitAlpha == 0
                    {
                        twistEnable = 0;
                    }
                }
            }
            else if createLightCount &gt;= 20
            {
                if gradientScale &lt; 1
                {
                    gradientScale += .2;
                }
            }
            
            if createLightTimer == 0
            {
                createLightCount++;
                createLightTimer = 5;
                var inst = instance_create(x+285/2, y+184/2, obj_galleryLight);
                inst.dir = random(360);
            }
            else
            {
                createLightTimer--;
            }
        }
        else
        {
            twistEnable = 0;
            kind = 2;
        }
        break;
    case 2:
        if waitTimer &lt; 30
        {
            waitTimer++;
        }
        else
        {
            if blackWarpScale &lt; 70
            {
                blackWarpScale += 2;
                maskRadius += 8;
            }
            else
            {
                if warpSurfaceScale &lt; 4
                {
                    warpSurfaceScale += .3;
                }
                if screenAlpha &lt; 1
                {
                    screenAlpha += .05;
                }
                else
                {
                    with objPlayer instance_destroy();
                    room_goto(rStage7_1);
                }
            }
        }
        break;
}
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Check whether in view
if x &gt; view_xview[0] || x + abs(sprite_width) &gt;= view_xview[0]
{
    inView = true;
}
else
{
    inView = false;
}
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Black Rect Animation
if kind &lt;= 1
{
    angleTimer = (angleTimer + 1) mod 360;
    angle = lengthdir_y(5, angleTimer);
    switch blackRectKind
    {
        case 0:
            if blackRectOffset &gt; -15
            {
                blackRectOffset--;
            }
            else
            {
                blackRectKind = 1;
            }
            break;
        case 1:
            if blackRectOffset &lt; 0
            {
                blackRectOffset++;
            }
            else
            {
                blackRectKind = 0;
            }
            break;
    }
}
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
