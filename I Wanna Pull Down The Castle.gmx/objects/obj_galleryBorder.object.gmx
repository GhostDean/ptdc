        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Transition Black Warp
if kind &gt;= 1 &amp;&amp; createLightCount &gt;= 10
{
    blackWarpAngle = (blackWarpAngle + 2) mod 360;
}
</string>
          </argument>
        </arguments>
      </action>
