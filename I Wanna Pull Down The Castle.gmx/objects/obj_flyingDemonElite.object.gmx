        <arguments>
          <argument>
            <kind>1</kind>
            <string>if attacking
{
    switch attackState
    {
        case ATTACK_STATE.CHARGING_SHOOT:
            if charging
            {
                if sprite_index == sprFlyDemonAttackACharge
                {
                    if chargeTimer &gt; 0 chargeTimer--;
                    else
                    {
                        scrChangeImage(sprFlyDemonAttackAShoot, .5);
                    }
                }
                else if !shot &amp;&amp; sprite_index == sprFlyDemonAttackAShoot &amp;&amp; (image_index &gt;= 3 &amp;&amp; image_index &lt; 4)
                {
                    with instance_create(x+10*image_xscale,y+14,obj_flyDemonBullet)
                    {
                        image_xscale = 2;
                        image_yscale = 2;
                        if instance_exists(objPlayer) direction = point_direction(x,y,objPlayer.x,objPlayer.y);
                        speed = 14;
                        image_angle = direction;
                    }
                    shot = 1;
                }
            }
            break;
        case ATTACK_STATE.BITE:
            var _dist = scrPlayerDistance();
            if _dist &lt;= attackRange
            {
                direction = 0;
                speed = 0;
                scrChangeImage(sprFlyDemonAttackB, .2);
            }
            else
            {
                scrFollowPlayerDirecton();
                image_xscale = sign(image_xscale) * 1.5;
                if instance_exists(objPlayer)
                    direction = point_direction(x,y,objPlayer.x,objPlayer.y);
                speed = moveSpeed;
                scrChangeImage(sprFlyDemonWalk, .2);
            }
            break;
    }
}
</string>
