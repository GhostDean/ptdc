        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>tex=sprite_get_texture(sprIrShadow2,0) //load the texture from the sprite
draw_primitive_begin_texture(pr_trianglestrip,tex) //draw texture begin,with each 3 points to draw a triangle
draw_set_color(c_white) //set the draw color white
draw_set_alpha(1) //set the draw alpha 1
//draw_set_blend_mode(bm_add) //set the draw blend mode add
for(i=0;i&lt;=ds_list_size(dsx)-1;i+=1){ //from 0 to list limit cycle
if(ds_list_find_value(dsx,i-1)!=undefined){ //avoid except 0
pdir=point_direction(ds_list_find_value(dsx,i),ds_list_find_value(dsy,i),ds_list_find_value(dsx,i-1),ds_list_find_value(dsy,i-1))
}
else{
pdir=0
}
px=ds_list_find_value(dsx,i) //find X list item
py=ds_list_find_value(dsy,i) //find Y list item
if(ds_list_size(dsx)&gt;1){xtex=i/(ds_list_size(dsx)-1)}else{xtex=0} //avoid except 0
draw_vertex_texture(px+lengthdir_x(texture_get_height(tex)*4,pdir+90),py+lengthdir_y(texture_get_height(tex)*4,pdir+90),xtex,0) //complex texture calculation
draw_vertex_texture(px+lengthdir_x(texture_get_height(tex)*4,pdir-90),py+lengthdir_y(texture_get_height(tex)*4,pdir-90),xtex,1)
}
draw_set_blend_mode(bm_normal) //set the draw blend mode normal
draw_primitive_end() //end the texture drawing (draw to screen)
</string>
