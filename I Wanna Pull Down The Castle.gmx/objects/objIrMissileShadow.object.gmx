        <arguments>
          <argument>
            <kind>1</kind>
            <string>if(instance_exists(parent)){
    mp_linear_step_object(parent.x,parent.y,16,0)

//move to (mouse_X,mouse_Y)
ds_list_add(dsx,x) //add X entry list
ds_list_add(dsy,y) //add Y entry list
if(ds_list_size(dsx)&gt;=100){ //if list number exceed the limit
ds_list_delete(dsx,0) //delete before the 100 frame X
ds_list_delete(dsy,0) //delete before the 100 frame Y
}
for(i=1;i&lt;=ds_list_size(dsx)-1;i+=1){ //collision code
cx=ds_list_find_value(dsx,i)
cy=ds_list_find_value(dsy,i)
lcx=ds_list_find_value(dsx,i-1)
lcy=ds_list_find_value(dsy,i-1)
}
}
</string>
          </argument>
