        <arguments>
          <argument>
            <kind>1</kind>
            <string>bossInst = noone;
bossId = 0;
bossName = '';

initGuiY = -100;
guiY = initGuiY;
targetY = 20;

curWidth = sprite_get_width(sprBossHp);
targetWidth = curWidth;
widthDecrementSpeed = 2;
width = curWidth;
height = sprite_get_height(sprBossHp);

animTimer = 0;

kind = 0;
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>switch kind
{
    case 0:
        animTimer++;
        guiY = EaseOutBack(animTimer/50, initGuiY, targetY, 1);
        if animTimer == 50
        {
            animTimer = 0;
            kind = 1;
        }
        break;
    case 1:
        if instance_exists(bossInst)
        {
            targetWidth = bossInst.hp / bossInst.maxHp * width;
            if curWidth != targetWidth
            {
                curWidth = max(curWidth - widthDecrementSpeed, targetWidth);
            }
            if bossInst.hp == 0
            {
                kind = 2;
            }
        }
        else
        {
            kind = 2;
        }
        break;
    case 2:
        animTimer++;
        guiY = EaseInBack(animTimer/50, targetY, initGuiY, 1);
        if animTimer == 50
        {
            instance_destroy();
        }
        break;
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
