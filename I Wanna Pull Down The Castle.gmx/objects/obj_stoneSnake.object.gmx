        <arguments>
          <argument>
            <kind>1</kind>
            <string>// do the speed limit
if abs(vspeed) &gt; 8 vspeed = sign(vspeed) * 8;
if hp == 0 exit;
if !active
{
    active = scrPlayerDistance() &lt;= radius;
}
else
{
    if instance_exists(objPlayer)
    {
        if noJump
        {
            if jumpTimer &gt; 0 jumpTimer--;
            else noJump = 0;
        }
        else
        {
            if !jumpReady
            {
                y = ystart;
                var _dist = abs(objPlayer.x - x);
                var _speedX = _dist / jumpHoriTime;
                direction = darccos(clamp(_speedX / jumpForce, -1, 1));
                if objPlayer.x &lt; x
                {
                    direction = 180 - direction;
                }
                speed = jumpForce;
                var _g = (speed * dsin(direction)) / (jumpHoriTime / 2);
                gravity = _g;
                jumpReady = 1;
                unlockDelay = 5;
            }
            else
            {
                image_angle = direction;
                moved = 1;
                if inBlockTime &gt;= 5
                {
                    vspeed = 0;
                    gravity = 0;
                    hspeed = sign(hspeed) * .001;
                    jumpReady = 0;
                    noJump = 1;
                    jumpTimer = jumpInterval;
                    inBlockTime = 0;
                    blockCountLocked = 1;
                }
            }
        }
    }
}
</string>
