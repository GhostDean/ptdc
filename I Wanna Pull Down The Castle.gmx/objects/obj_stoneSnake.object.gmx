            <kind>1</kind>
            <string>depth = 9999999999;
hp = 12;

radius = 120;

snakePartNum = 12;

moved = 0;
jumpReady = 0;
jumpTimer = 0;
jumpInterval = 100;
noJump = 0;
jumpForce = 7;
jumpHoriTime = 50;
inBlockTime = 0;
blockCountLocked = 1;
unlockDelayTimer = 0;
unlockDelay = 0;

image_speed = 0;

parts = ds_list_create();
for (var i = 1; i &lt;= snakePartNum; i++)
{
    var _offset = 3 * sign(sprite_width);
    if i &gt;= 2 _offset += 5 * (i - 1) * sign(sprite_width);
    var part = instance_create(x-sprite_width*i+_offset, y, obj_stoneSnakePart);
    if i == 1
    {
        part.parent = self.id;
    }
    else
    {
        part.parent = parts[| i - 2];
    }
    part.depth = depth;
    part.root = id;
    parts[| i - 1] = part;
}
</string>
