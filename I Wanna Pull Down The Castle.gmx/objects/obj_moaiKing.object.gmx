        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Shake
if shakeTimer &gt; 0
{
    shakeTimer--;
    view_xview[0] = round(random_range(-4, 4));
    view_yview[0] = round(random_range(-4, 4));
}
else
{
    view_xview[0] = 0;
    view_yview[0] = 0;
}
</string>
