    <event eventtype="2" enumb="1">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>with instance_create(random(800), 0, obj_moaiKingLaser)
{
    image_alpha = 1;
    image_yscale = 0;
    type = 2;
    dir = scrLookAtPlayer();
    openTimer = 40;
}
alarm[1] = irandom_range(40, 50);
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="2" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Decide next behavior
curState = choose(STATE_DASH, STATE_MOVE, STATE_JUMP);
if hp &lt;= maxHp / 2 &amp;&amp; !didLaserAction
{
    curState = STATE_ROTATE_LASER;
    didLaserAction = 1;
    stoneBurstNum = 8;
}

// behavior initialization
switch curState
{
    case STATE_MOVE:
        leftFootShake = 0;
        rightFootShake = 1;
        shakeTimer = 0;
        if (x &gt;= 96 &amp;&amp; x &lt;= 96 + moveThreshold)
        {
            movePosX = irandom_range(x + 96 + moveThreshold, x + 96 + moveThreshold * 2);
        }
        else if (x &gt;= 800 - moveThreshold) &amp;&amp; (x &lt;= 800)
        {
            movePosX = irandom_range(x - moveThreshold * 2, x - moveThreshold);
        }
        else
        {
            movePosX = irandom_range(x - moveThreshold, x + moveThreshold);
        }
        scrChangeImage(sprMoaiKingWalk, .2);
        break;
    case STATE_DASH:
        dashDir = 0;
        dashToEdge = 0;
        dashReadyTimer = 100;
        dashPosX = 800 - x;
        dashEffectTimer = 0;
        scrChangeImage(sprMoaiKingWalk, 0);
        break;
    case STATE_JUMP:
        jumpShadow = 1;
        jumpUpTimer = 0;
        jumpCrash = 0;
        vspeed = -jumpUpSpeed;
        scrChangeImage(sprMoaiKingJump, .3);
        with instance_create(x - 60 * image_xscale, y, obj_shadow)
        {
            image_xscale = -other.image_xscale;
            type = 2;
            sprite_index = sprMoaiKingJumpPoof;
            image_speed = .1;
        }
        break;
    case STATE_ROTATE_LASER:
        invincible = true;
        audio_play_sound(sndBlockChange, 0, 0);
        instance_create(x, y - 200, obj_moaiKingRotate);
        for (var i = 0; i &lt; laserNum; i++)
        {
            // left
            var _eyeX = x - 7 * image_xscale;
            var _eyeY = y - 62;
            laser[i] = instance_create(_eyeX, _eyeY, obj_moaiKingLaser);
            laser[i].dir = 360 / laserNum * i;
            laser[i].depth = depth - 1;
            // right
            _eyeX = x + 24 * image_xscale;
            laser[laserNum + i] = instance_create(_eyeX, _eyeY, obj_moaiKingLaser);
            laser[laserNum + i].dir = 360 / laserNum * i;
            laser[laserNum + i].depth = depth - 1;
        }
        break;
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="2">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if hp == 0 exit;
if laserPhaseMoving exit;
if sprite_index != sprMoaiKingActivate
{
    if place_meeting(x, y, objPlayer) scrKillPlayer();
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if hp == 0
{
    if hpAlpha &gt; 0 hpAlpha -= .1;
    exit;
}
if global.bossItem[4] exit;
if !active
{
    if keyboard_check_pressed(vk_up) &amp;&amp; place_meeting(x, y, objPlayer)
    {
        audio_play_sound(musMoaiKing, 0, 1);
        image_speed = .2;
        active = 1;
        with instance_create(736, 480, objSpikeDown)
        {
            sprite_index = QSprS5SpikeDown;
        }
        with instance_create(736, 512, objSpikeUp)
        {
            sprite_index = QSprS5SpikeUp;
        }
        scrInitHpBar(id, 4, 'Golem King');
    }
    if place_meeting(x, y, objPlayer)
    {
        if hintAlpha &lt; 1 hintAlpha += .05;
    }
    else
    {
        if hintAlpha &gt; 0 hintAlpha -= .05;
    }
}
else
{
    switch curState
    {
        case STATE_DASH:
            if dashReadyTimer &gt; 0
            {
                dashReadyTimer--;
                if dashEffectTimer == 0
                {
                    scrCreateShadow(1, c_white);
                    dashEffectTimer = 3;
                }
                else
                {
                    dashEffectTimer--;
                }
            }
            else
            {
                if dashDir == 0
                {
                    if x &lt; 400 dashDir = -1;
                    else dashDir = 1;
                    image_speed = .2;
                    image_xscale = dashDir;
                }
                scrCreateShadow(0, c_white);
                x += dashSpeed * dashDir;
                if dashDir == -1
                {
                    if !dashToEdge
                    {
                        if bbox_right &lt; 0
                        {
                            x = 800 - x;
                            dashToEdge = 1;
                        }
                    }
                    else
                    {
                        x = max(x, dashPosX);
                        if x == dashPosX event_user(0);
                    }
                }
                else
                {
                    if !dashToEdge
                    {
                        if bbox_left &gt; 800
                        {
                            dashToEdge = 1;
                            x = 800 - x;
                        }
                    }
                    else
                    {
                        x = min(x, dashPosX);
                        if x == dashPosX event_user(0);
                    }
                }
            }
            break;
        case STATE_MOVE:
            if image_index &gt;= 3 &amp;&amp; image_index &lt; 4 &amp;&amp; !leftFootShake
            {
                if rightFootShake rightFootShake = 0;
                leftFootShake = 1;
                shakeTimer = 10;
            }
            else if image_index &gt;= 0 &amp;&amp; image_index &lt; 1 &amp;&amp; !rightFootShake
            {
                if leftFootShake leftFootShake = 0;
                rightFootShake = 1;
                shakeTimer = 10;
            }
        
            if movePosX == x
            {
                event_user(0);
            }
            else if movePosX &gt; x
            {
                image_xscale = 1;
                x = min(x + moveSpeed, movePosX);
            }
            else if movePosX &lt; x
            {
                image_xscale = -1;
                x = max(x - moveSpeed, movePosX);
            }
            break;
        case STATE_JUMP:
            if bbox_bottom &lt; 0
            {
                if jumpUpTimer &lt; 100
                {
                    if vspeed != 0 vspeed = 0;
                    jumpUpTimer++;
                    if instance_exists(objPlayer) x = objPlayer.x;
                }
                else
                {
                    jumpUpTimer = 0;
                    vspeed = 19;
                }
            }
            break;
        case STATE_ROTATE_LASER:
            if !hasLaserInited
            {
                if laserTimer &lt; 150
                {
                    laserTimer++;
                }
                else
                {
                    laserTimer = 0;
                    hasLaserInited = 1;
                    laserRotatePhase = 1;
                    for (var i = 0 ; i &lt; laserNum; i++)
                    {
                        for (var j = 0; j &lt; 2; j++)
                        {
                            laser[i + laserNum * j].image_alpha = 1;
                        }
                    }
                }
            }
            else
            {
                switch laserRotatePhase
                {
                    case 1:
                        laserDir += .3;
                        laserTimer++;
                        if laserTimer == 100
                        {
                            audio_play_sound(sndBlockChange, 0, 0);
                            laserTimer = 0;
                            laserRotatePhase++;
                        }
                        break;
                    case 2:
                        laserDir -= .4;
                        laserTimer++;
                        if laserTimer == 150
                        {
                            with obj_moaiKingLaser fade = 1;
                            with obj_moaiKingRotate crash = 1;
                            audio_play_sound(sndBlockChange, 0, 0);
                            laserTimer = 0;
                            laserRotatePhase++;
                            laserPhaseMoving = true;
                        }
                        break;
                    case 3:
                        if (round(x) != 400 || round(y) != 304) &amp;&amp; laserTimer == 0
                        {
                            x += (400 - x) / 8;
                            y += (304 - y) / 8;
                            scrCreateShadow(0, c_white);
                        }
                        else
                        {
                            if laserTimer == 0
                            {
                                laserPhaseMoving = false;
                                audio_play_sound(sndBlockChange, 0, 0);
                                laserTimer++;
                                alarm[1] = 30;
                                for (var i = 0; i &lt; 3; i++)
                                {
                                    for (var j = 0; j &lt; 2; j++)
                                    {
                                        var _len = 150;
                                        var _dir = 90 + 360 / 3 * i + -180 * j;
                                        var _laser = instance_create(x + lengthdir_x(_len, _dir), y + lengthdir_y(_len, _dir) - 115/2, obj_moaiKingLaser);
                                        _laser.dir = _dir + 150;
                                        _laser.image_alpha = 1;
                                        _laser.image_yscale = 0;
                                        _laser.type = 1;
                                        _laser.maxLength = 261;
                                    }
                                }
                            }
                            else
                            {
                                if laserTimer &lt; 500
                                {
                                    laserTimer++;
                                    if laserTimer mod 15 == 0
                                    {
                                        with instance_create(random(800), 0, obj_moaiKingStone)
                                        {
                                            gravity = .3;
                                            type = 2;
                                            rotateDir = choose(-1, 1);
                                        }
                                    }
                                }
                                else
                                {
                                    with obj_moaiKingLaser fade = 1;
                                    alarm[1] = -1;
                                    if round(y) != ystart y += (ystart - y) / 4;
                                    else
                                    {
                                        curState = STATE_IDLE;
                                        event_user(0);
                                    }
                                }
                            }
                        }
                        break;
                }
                if laserPrevDir != laserDir
                {
                    laserPrevDir = laserDir;
                    for (var i = 0 ; i &lt; laserNum; i++)
                    {
                        for (var j = 0; j &lt; 2; j++)
                        {
                            laser[i + laserNum * j].dir = laserDir + (360 / laserNum * i);
                            if j == 1 laser[i + laserNum * j].dir *= -1;
                        }
                    }
                }
            }
            break;
    }
}
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
