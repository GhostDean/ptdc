        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>image_speed = 0;
maxHp = 60;
hp = maxHp;
active = 0;

// shake
leftFootShake = 0;
rightFootShake = 1;
shakeTimer = 0;
// other
hintAlpha = 0;
invincible = false;

hpAlpha = 1;
</string>
          </argument>
        </arguments>
      </action>
