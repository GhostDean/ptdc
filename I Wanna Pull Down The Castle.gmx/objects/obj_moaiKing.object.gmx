        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Define States
STATE_IDLE = 0;
STATE_DASH = 1;
STATE_JUMP = 2;
STATE_ROTATE_LASER = 3;
STATE_DEAD = 4;
STATE_MOVE = 5;

curState = STATE_IDLE;

// state vars
stoneBurstNum = 5;
// laser
didLaserAction = 0;
// move
movePosX = x;
moveThreshold = 96;
moveSpeed = 3;
// dash
dashReadyTimer = 0;
dashPosX = x;
dashSpeed = 12;
dashToEdge = 0;
dashEffectTimer = 0;
// jump
jumpShadow = 0;
jumpUpSpeed = 19;
jumpUpTimer = 0;
jumpCrash = 0;
// laser
hasLaserInited = 0;
laserDir = 0;
laserPrevDir = 0;
laserNum = 4;
laserTimer = 0;
laserRotatePhase = 0;
laserPhaseMoving = false;
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
