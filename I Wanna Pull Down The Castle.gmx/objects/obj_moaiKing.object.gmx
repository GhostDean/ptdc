    <event eventtype="4" ename="objBullet">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if global.bossItem[4] exit;
if sprite_index == sprMoaiKingActivate exit;
if hp == 0 exit;
if invincible exit;
if hp - 1 &gt; 0
{
    repeat(irandom_range(1,stoneBurstNum))
    {
        var stone = instance_create(other.x, other.y, obj_moaiKingStone);
        stone.speed = random_range(5,8);
        stone.gravity = .2;
        stone.image_xscale = .5;
        stone.image_yscale = .5;
        stone.rotateDir = choose(-1, 1);
        if other.x &lt; x stone.direction = random_range(180-60, 180+30);
        else stone.direction = random_range(-30, 90);
    }
    hp--;
    audio_play_sound(sndBossHit2, 0, 0);
    image_blend = c_red;
    alarm[11] = 5;
}
else
{
    global.bossItem[4] = 1;
    scrSaveGame(1);
    hp = 0;
    audio_play_sound(sndDeath, 0, 0);
    audio_stop_sound(musMoaiKing);
    curState = STATE_DEAD;
    y = ystart;
    vspeed = 0;
    alarm[0] = -1;
    scrChangeImage(sprMoaiKingDead, .1);
}
with other instance_destroy();
</string>
          </argument>
        </arguments>
      </action>
    </event>
