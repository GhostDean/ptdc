        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if vspeed &gt; 0 &amp;&amp; !jumpCrash &amp;&amp; curState == STATE_JUMP
{
    vspeed = 0;
    jumpCrash = 1;
    y = min(y, ystart);
    jumpShadow = 0;
    shakeTimer = 15;
    repeat(irandom_range(30, 40))
    {
        with instance_create(x, y, obj_moaiKingStone)
        {
            direction = random_range(90-45, 90+45);
            speed = random_range(6, 12);
            gravity = .2;
            rotateDir = choose(-1, 1);
        }
    }
    event_user(0);
}
</string>
