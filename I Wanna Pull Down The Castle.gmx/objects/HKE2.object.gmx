audio_play_sound(HKR2FS,1,0)
}
if(audio_is_playing(HKR2FS)and !(x&gt;view_xview[0] and x&lt;view_xview[0]+800 and y&gt;view_yview[0] and y&lt;view_yview[0]+608)){
audio_stop_sound(HKR2FS)
}
if distance_to_object(objPlayer) &lt;=1600 and distance_to_object(objPlayer) &gt;=100
{
mp_potential_step(objPlayer.x,objPlayer.y,-4*image_xscale,0)
}
else
{
motion_set(0,0)
}
if distance_to_object(objPlayer) &lt;=100 {
mp_potential_step(objPlayer.x,objPlayer.y,2*image_xscale,0)
}
else
{
motion_set(0,0)
}
dir=point_direction(x,y,objPlayer.x,objPlayer.y)
if(dir&gt;90 and dir&lt;270){xsc=1}
else{xsc=-1}
if(cd2=0){
image_xscale=xsc
cd2=50}
if(distance_to_object(objPlayer)&gt;=100 and distance_to_object(objPlayer)&lt;=300 and cd=0){
skill=1//irandom_range(1,2)
}
if(distance_to_object(objPlayer) &lt;=300 and y&gt;objPlayer.y){mp_potential_step(x,objPlayer.y,3,0)
}
else
{
motion_set(0,0)
}
if(skill=1){sprite_index=HKS2A2 audio_play_sound(HKR2AS1,1,0) image_xscale=xsc image_speed=0.1 skill=0 
}

//if(sprite_index=HKS2A1B){

