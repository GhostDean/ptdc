    <event eventtype="4" ename="objBullet">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if(canshoot and nowhp&gt;0){
  with(other){
    repeat(3){
     instance_create(x,y,objFBhit);
    }
    instance_destroy();
  }
  nowhp-=1;
  with(objFBhp){
    var t;
    repeat(2){
      t=instance_create(x+650*hpPer,y+random(16),objFBhit);
      t.speed=random_range(5,7);
      t.direction=random_range(175,185);
    }
  }
  audio_playsound(sndBossHit);
  var ex=false;
  if(instance_exists(objFBatk3)){
    if(objFBatk3.stage==1)ex=true;
  }
  if(instance_exists(objFBatk4)){
    if(objFBatk4.stage==1)ex=true;
  }
  if(ex){
    var t,dir,coll;
    dir=random(360);
    repeat(12){
      t=instance_create(x,y,objFBdm);
      t.sprite_index=sprFBspk;
      t.image_blend=global.FBcol//c_red;
      t.speed=6;t.ima=91;
      t.direction=dir;
      t=instance_create(x,y,objFBdm);
      t.sprite_index=sprFBspk;
      t.image_blend=global.FBcol//c_red;
      t.speed=5;t.ima=91;
      t.direction=dir+360/24;
      dir+=360/12;
    }
  }
  canshoot=0;alarm[1]=50;
}
</string>
          </argument>
        </arguments>
      </action>
