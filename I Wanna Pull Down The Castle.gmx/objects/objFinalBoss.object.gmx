        <arguments>
          <argument>
            <kind>1</kind>
            <string>if(yd=0){
  x+=(tox-x)/ydtime;
  y+=(toy-y)/ydtime;
}else if(yd=2){
  y=oy+sin(sy)*yr;
  sy+=sysd;
}

if(change_col){
  if(hue&lt;to_hue)hue+=1;
  if(sat&lt;to_sat)sat+=4;
  if(val&lt;to_val)val+=1;
  
  if(hue&gt;to_hue)hue-=1;
  if(sat&gt;to_sat)sat-=4;
  if(val&gt;to_val)val-=1;
  
  global.FBcol=make_color_hsv(hue,sat,val);
  image_blend=make_color_hsv(hue,sat,255);
  if(instance_exists(objFBblock))objFBblock.image_blend=global.FBcol;
  objFBcircle.image_blend=global.FBcol;
  background_blend=global.FBcol;
  if(to_hue=100000){
    with(objFBdm){
      if(alsd&lt;0)image_blend=objFinalBoss.image_blend;
    }
  }
}
if(instance_exists(objFBatk3)){
if(objFBatk3.stage=2){
  if(y&gt;500){
    objFBatk3.stage=0;
    with(objFBblock){
      a=instance_create(x,y,objFBshadow);
      a.sprite_index=sprFBblock;
      a.image_blend=global.FBcol;
      a.sd=0.02;
      a.hspeed=random_range(-2,2);
      a.vspeed=random_range(-2,-1);
      a.gravity=0.1;
      instance_destroy();
    }
  }
}
}
if(des){
  if(nowhp&gt;0)nowhp-=1;
}
if(!surface_exists(sprsurf))sprsurf=surface_create(170,170);
surface_set_target(sprsurf);
draw_sprite(sprFinalBoss,0,85,85);
draw_sprite_ext(sprFBlight,-1,85,85,1,1,0,image_blend,1);
surface_reset_target();
</string>
