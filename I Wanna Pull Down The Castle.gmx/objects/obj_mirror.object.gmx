        <arguments>
          <argument>
            <kind>1</kind>
            <string>if !global.bossMKidCutscene
{
    global.bossMKidCutscene = 1;
    scrSaveGame(false);
}
with objPlayer frozen = 0;
with instance_create(x, y, obj_mirroredKid)
{
    scrInitHpBar(id, 5, 'Mirrored Kid');
}
//with instance_create(32, 480, obj_mkGateSpike) down = 1;
//with instance_create(32, 512, obj_mkGateSpike) up = 1;
with instance_create(352, 320, objSpikeRight) image_xscale = 1.5;
with instance_create(400, 320, objSpikeLeft) image_xscale = 1.5;
instance_destroy();
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="2">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if !surface_exists(surf)
{
    surf = surface_create(abs(sprite_width), abs(sprite_height));
}
surface_set_target(surf);
draw_clear_alpha(c_black, 0);
with objPlayer
{
    var xx = other.x - x, yy = y - other.y + 35;
    draw_sprite_ext(sprite_index, image_index, xx, yy, -xScale, image_yscale, image_angle, image_blend, .75);
    if other.darkAlp &gt; 0 draw_sprite_ext(sprite_index, image_index, xx, yy, -xScale * 1.1, 1.1, image_angle, make_colour_rgb(139, 0, 0), min(other.darkAlp, .75));
}
draw_set_blend_mode(bm_subtract);
draw_sprite(sprite_index, 1, 18, 35);
draw_set_blend_mode(bm_normal);
surface_reset_target();
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if global.bossItem[5] exit;

if(scrCheckPlayerExists()){
if !triggered &amp;&amp; !skipPressed &amp;&amp; scrPlayerDistance() &lt;= 40 &amp;&amp; objPlayer.x&lt;x-20 &amp;&amp; objPlayer.x&gt;x-28
{
    triggered = 1;
    with objPlayer frozen = 1;
}
}

if triggered
{
    if keyboard_check_pressed(ord('S')) &amp;&amp; global.bossMKidCutscene
    {
        alarm[0] = 1;
        skipAlp = 0;
        audio_stop_sound(sndGlass);
        audio_stop_sound(sndAppear);
        triggered = 0;
        skipPressed = 1;
        exit;
    }
    if skipAlp &lt; 1 &amp;&amp; global.bossMKidCutscene skipAlp += .025;
    if darkAlp &lt; 1
    {
        if darkAlp == 0 audio_play_sound(sndAppear, 0, 0);
        darkAlp += .01;
    }
    else
    {
        if timer &lt; 50
        {
            timer++;
        }
        else
        {
            triggered = 0;
            skipPressed = 1;
            audio_play_sound(sndGlass, 0, 0);
            with instance_create(0, 0, obj_mkEffect)
            {
                kind = 1;
                time = 4;
            }
            alarm[0] = 2;
        }
    }
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
