            <string>if !sprite_exists(global.portalSnapshot[portalId]) &amp;&amp; place_meeting(x, y, objPlayer)
{
    var _path = working_directory + '\teleportSnaps\portalSnapshot' + string(portalId) + '.png';
    var _width = 200;
    var _height = 150;
    QmapFollowCan.visible = 0;
    screen_save_part(_path, x-_width/2, y-_height/2, _width, _height);
    QmapFollowCan.visible = 1;
    global.portalSnapshot[portalId] = sprite_add(_path, 1, 0, 0, 100, 75);
}
</string>
