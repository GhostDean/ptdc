            <string>draw_set_font(fntPixel30);
draw_set_halign(1);
draw_set_valign(1);
draw_set_alpha(snapshotAlpha);
draw_text(400, 100, 'Select Teleport Point');
draw_text(400, 150, 'Teleport Point ' + string(teleName[curSelectedIndex]));
draw_set_halign(fa_right);
draw_set_valign(fa_top);
