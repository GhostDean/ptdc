      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if instance_exists(obj_teleportFade) exit;
if !activate
{
    if blackBGAlpha &gt; 0 blackBGAlpha -= .1;
    if snapshotAlpha &gt; 0 snapshotAlpha -= .1;
    if place_meeting(x, y, objPlayer)
    {
        if keyHintAlpha &lt; 1 keyHintAlpha += .05;
        
        if keyHintTimer == 0
        {
            keyHintIndex = !keyHintIndex;
            keyHintTimer = 50;
        }
        else
        {
            keyHintTimer--;
        }
        
        if keyboard_check_pressed(ord('S'))
        {
            with objPlayer frozen = 1;
            activate = 1;
            /*for (var i = 0; i &lt; global.snapshotNum; i++)
            {
                snapshot[i] = instance_create(0, 0, obj_portalSnapshot);
                snapshot[i].angle = 360 / global.snapshotNum * i;
                if sprite_exists(global.portalSnapshot[i])
                {
                    snapshot[i].sprite_index = global.portalSnapshot[i];
                }
                else
                {
                    snapshot[i].sprite_index = sprLockedTelePoint;
                }
            }*/
            event_user(0);
            //event_user(1);
        }
    }
    else
    {
        if keyHintAlpha &gt; 0 keyHintAlpha -= .05;
        if keyHintIndex != 0 keyHintIndex = 0;
        if keyHintTimer != 50 keyHintTimer = 50;
    }
}
else
{
    /*if blackBGAlpha &lt; 1 blackBGAlpha += .05;
    else
    {
        if snapshotRadiusH &lt; snapshotRadiusHMax
        {
            snapshotRadiusH = min(snapshotRadiusH + snapshotRadiusIncrement, snapshotRadiusHMax);
            snapshotAlpha = min(snapshotAlpha + snapshotRadiusHMax / snapshotRadiusIncrement, 1);
            animRotateAngle = min(animRotateAngle + 360 / (snapshotRadiusHMax / snapshotRadiusIncrement), 360);
            animScaleRatio = min(animScaleRatio + 1 / (snapshotRadiusHMax / snapshotRadiusIncrement), 1);
        }
        else
        {
            if snapshotAlpha &lt; 1 snapshotAlpha += .1;
            if targetRotateAngle != curSelectAngle
            {
                if curSelectAngle &lt; targetRotateAngle
                {
                    curSelectAngle = min(curSelectAngle + animRotateSpeed, targetRotateAngle);
                }
                if curSelectAngle &gt; targetRotateAngle
                {
                    curSelectAngle = max(curSelectAngle - animRotateSpeed, targetRotateAngle);
                }
            }*/

            count=global.snapshotNum
            if keyboard_check_pressed(vk_left)
            {
                //if targetRotateAngle != curSelectAngle exit;
                //targetRotateAngle -= snapshotAngleDelta;
                  
                while(count&gt;0)
                {
                    curSelectedIndex--;
                    if curSelectedIndex == -1 
                        curSelectedIndex = global.snapshotNum - 1;
                    if(global.map[teleX[curSelectedIndex],teleY[curSelectedIndex]])
                        break;
                    count--;
                }
            }
            
            if keyboard_check_pressed(vk_right)
            {
                //if targetRotateAngle != curSelectAngle exit;
                //targetRotateAngle += snapshotAngleDelta;
                
                
                while(count&gt;0)
                {
                    curSelectedIndex++;
                    if curSelectedIndex == global.snapshotNum
                    {
                        curSelectedIndex = 0;
                    }
                    if(global.map[teleX[curSelectedIndex],teleY[curSelectedIndex]])
                        break;
                    count--;
                }
            }
            
            if keyboard_check_pressed(ord('Z'))
            {
                //if targetRotateAngle != curSelectAngle exit;
                //if global.map[teleX[curSelectedIndex], teleY[curSelectedIndex]] &amp;&amp; teleportRoom[curSelectedIndex] != room
                if teleportRoom[curSelectedIndex] != room
                {
                    with objPlayer frozen = 1;
                    with instance_create(0, 0, obj_teleportFade)
                    {
                        targetRoom = other.teleportRoom[other.curSelectedIndex];
                        warpX = other.warpX[other.curSelectedIndex];
                        warpY = other.warpY[other.curSelectedIndex];
                    }
                }
            }
            
            if keyboard_check_pressed(ord('C'))
            {
                if targetRotateAngle != curSelectAngle exit;
                activate = 0;
                with objPlayer frozen = 0;
                with obj_portalSnapshot instance_destroy();
            }
        //}
    //}
    // refresh snapshot instance state
    event_user(0);
}
</string>
