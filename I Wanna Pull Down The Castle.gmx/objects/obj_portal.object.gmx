draw_set_halign(fa_left);
draw_set_font(fDefault12);
if(activate &amp;&amp; sprite_exists(global.portalSnapshot[curSelectedIndex]))
    draw_sprite(global.portalSnapshot[curSelectedIndex],0,ellipseX, ellipseY-100);
</string>
