    <event eventtype="7" enumb="11">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Set snapshot instance state
for (var i = 0; i &lt; global.snapshotNum; i++)
{
    snapshot[i].x = snapshotX[i];
    snapshot[i].y = snapshotY[i];
    snapshot[i].image_xscale = snapshotScale[i] * animScaleRatio;
    snapshot[i].image_yscale = snapshotScale[i] * animScaleRatio;
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="7" enumb="10">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Refreshing Snapshot state
for (var i = 0; i &lt; global.snapshotNum; i++)
{
    var _dir = initSelectAngle + curSelectAngle + animRotateAngle - 360 / global.snapshotNum * i;
    snapshotX[i] = ellipseX + lengthdir_x(snapshotRadiusH, _dir);
    snapshotY[i] = ellipseY + lengthdir_y(snapshotRadiusV, _dir);
    snapshotScale[i] = max(abs(.5 + dsin(_dir) / 2), .1);
    if instance_exists(snapshot[i])
    {
        snapshot[i].image_alpha = snapshotAlpha;
        snapshot[i].angle = _dir;
    }
}
if instance_exists(obj_portalSnapshot)
{
    event_user(1);
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
