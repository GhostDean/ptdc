            <string>var imageNumber = sprite_get_number(bossSpr);
if !imgTimer
{
    imgTimer = 30;
    bossIdx = (bossIdx + 1) mod imageNumber;
}
else
{
    imgTimer--;
}

if createTimer &gt; 0 createTimer--;

if !createTimer &amp;&amp; (stage == 1 || (stage == 2 &amp;&amp; timer &lt; 20))
{
    var _dir = random(360);
    createTimer = 6;
    instance_create(bossX + lengthdir_x(80, _dir), bossY + lengthdir_y(80, _dir), obj_s4bSpellBall);
}

if screenFlash
{
    if rectAlpha &gt; 0 rectAlpha -= .05;
    else screenFlash = 0;
}
</string>
