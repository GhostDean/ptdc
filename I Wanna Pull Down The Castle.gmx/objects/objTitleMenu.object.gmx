    if show_question('Are you sure to overwrite this save?')
    {
        for (var i = 0; i &lt; global.snapshotNum; i++)
        {
            var _path = 'portalSnapshot' + string(i) + '.png';
            if file_exists(_path)
            {
                file_delete(_path);
                sprite_delete(global.portalSnapshot[i]);
                global.portalSnapshot[i] = -1;
            }
        }
        global.gameStarted=true;
        global.autosave=true;
        global.difficulty=0;
        alarm[0]=100;
        o=instance_create(0,0,objSlLPef);
        o.sprite_index=sprBlock;
        o.image_blend=0;
        o.image_xscale=25;
        o.image_yscale=19;
        o.image_alpha=0;
        o.sd=-0.01
