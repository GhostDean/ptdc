        <arguments>
          <argument>
            <kind>1</kind>
            <string>if hp == 0 exit;
if !headless
{
    if !active
    {
        scrChangeImage(sprPumpkinIdle, .1);
        if hspeed != 0 hspeed = 0;
        if scrPlayerDistance() &lt;= radius
        {
            active = true;
        }
    }
    else if hp &gt; 0
    {
        if instance_exists(objPlayer)
        {
            scrFollowPlayerDirecton();
            if sprite_index != sprPumpkinWalk
            {
                image_speed = .2;
                sprite_index = sprPumpkinWalk;
            }
            scrBasicEnemyMovement(moveSpeed);
        }
    }
    else
    {
        if (image_index &gt;= 6 &amp;&amp; image_index &lt; 7) &amp;&amp; !throwed
        {
            with instance_create(x,y-sprite_height,obj_pumpkinHead)
            {
                direction = point_direction(x,y,objPlayer.x,objPlayer.y);
                speed = 12;
            }
            headless = true;
            throwed = true;
        }
    }
}
else
{
    active = 1;
}
</string>
          </argument>
        </arguments>
