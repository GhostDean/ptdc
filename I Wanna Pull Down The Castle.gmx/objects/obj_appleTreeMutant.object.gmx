    <event eventtype="2" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Next attack decision
if hp == 0 exit;
while 1
{
    curState = choose(STATE_MOVE, STATE_THROW, STATE_DIG_ATTACK);
    
    switch curState
    {
        case STATE_MOVE:
            if x &lt; 400
            {
                if x &lt; 64 + moveThreshold
                {
                    movePosX = irandom_range(x+moveThreshold, x+moveThreshold*2);
                }
                else
                {
                    movePosX = irandom_range(x-moveThreshold, x+moveThreshold);
                }
            }
            else
            {
                if x &gt; 736 - moveThreshold
                {
                    movePosX = irandom_range(x-moveThreshold*2, x-moveThreshold);
                }
                else
                {
                    movePosX = irandom_range(x-moveThreshold, x+moveThreshold);
                }
            }
            break;
        case STATE_THROW:
            if scrPlayerDistance() &lt;= throwAttackRadius
            {
                continue;
                break;
            }
            else
            {
                scrChangeImage(sprATMAttack, .3);
            }
            break;
        case STATE_DIG_ATTACK:
            scrChangeImage(sprATMAttack2, .5);
            break;
    }
    break;
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if hp == 0 exit;
if !instance_exists(objPlayer) exit;
switch curState
{
    case STATE_AWAKE:
        scrChangeImage(sprATMActivate, .3);
        break;
    case STATE_IDLE:
        if hspeed != 0 hspeed = 0;
        scrChangeImage(sprATMIdle, .3);
        break;
    case STATE_MOVE:
        if x &gt; movePosX
        {
            image_xscale = -1;
            x = max(x - moveSpeed, movePosX);
        }
        else if x &lt; movePosX
        {
            image_xscale = 1;
            x = min(x + moveSpeed, movePosX);
        }
        else
        {
            curState = STATE_IDLE;
            alarm[0] = random_range(30, 50);
        }
        break;
    case STATE_THROW:
        scrFollowPlayerDirecton();
        if !throwAppleFinished
        {
            if image_index &gt;= 12 &amp;&amp; image_index &lt; 13
            {
                throwAppleFinished = 1;
                with instance_create(x-4*image_xscale, y-44, obj_atmApple)
                {
                    speed = other.throwAppleSpeed;
                    direction = scrLookAtPlayer();
                    image_xscale *= other.throwAppleScale;
                    image_yscale *= other.throwAppleScale;
                    if other.hp &lt; other.maxHp / 2 special = 1;
                }
            }
        }
        break;
    case STATE_DIG_ATTACK:
        if !digAttackSpawned
        {
            if image_index &gt;= 4 &amp;&amp; image_index &lt; 5 &amp;&amp; instance_number(obj_atmMinion) &lt; 4
            {
                digAttackSpawned = 1;
                with instance_create(0, 0, obj_mkEffect)
                {
                    kind = 2;
                    time = 10;
                }
                with instance_create(random_range(64+16, 736-16), 64+16, obj_atmMinion)
                {
                    vspeed = 1;
                    gravity = .2;
                    rotateDir = choose(-1, 1);
                }
            }
        }
        break;
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="4" ename="objBullet">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if hp == 0 exit;
if curState == STATE_INACTIVE || curState == STATE_AWAKE exit;
with other instance_destroy();
hp--;
if hp &gt; 0
{
    if hp &lt; maxHp / 3 &amp;&amp; !minionBuffed
    {
        audio_play_sound(sndBlockChange, 0, 0);
        with obj_atmMinion
        {
            moveSpeed *= 1.5;
        }
        minionBuffed = 1;
    }
    audio_play_sound(sndBossHit2, 0, 0);
    image_blend = c_red;
    alarm[11] = 2;
}
else
{
    audio_play_sound(sndDeath, 0, 0);
    curState = STATE_DEAD;
    scrChangeImage(sprATMDead, .2);
    audio_stop_sound(musAppleTreeMutant);
    with obj_atmMinion instance_destroy();
    with obj_atmApple instance_destroy();
    with objSpikeDown
    {
        instance_destroy();
    }
    with objSpikeUp
    {
        instance_destroy();
    }
    global.noPause = 0;
    global.bossItem[0] = 1;
    scrSaveGame(0);
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="4" ename="objPlayer">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if curState == STATE_INACTIVE || curState == STATE_AWAKE exit;
if hp == 0 exit;
scrKillPlayer();
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="7" enumb="7">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>switch curState
{
    case STATE_AWAKE:
        curState = STATE_IDLE;
        alarm[0] = random_range(30, 50);
        break;
    case STATE_THROW:
        throwAppleFinished = 0;
        curState = STATE_IDLE;
        alarm[0] = random_range(30, 50);
        break;
    case STATE_DIG_ATTACK:
        digAttackSpawned = 0;
        curState = STATE_IDLE;
        alarm[0] = random_range(30, 50);
        break;
    case STATE_DEAD:
        if sprite_index == sprATMDead
        {
            image_index = 16;
            image_speed = 0;
        }
        break;
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
