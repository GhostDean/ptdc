        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Define States
STATE_INACTIVE = 1;
STATE_AWAKE = 2;
STATE_IDLE = 3;
STATE_MOVE = 4;
STATE_THROW = 5;
STATE_DIG_ATTACK = 6;
STATE_DEAD = 7;

/// State vars
// move
moveThreshold = 40;
movePosX = x;
moveSpeed = 3;
// throw
throwAppleFinished = 0;
throwAppleSpeed = 8;
throwAppleScale = 2;
throwAttackRadius = 100;
// dig attack
digAttackSpawned = 0;
// minion
minionBuffed = 0;

curState = STATE_INACTIVE;
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>maxHp = 50;
hp = maxHp;
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="2" enumb="11">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
