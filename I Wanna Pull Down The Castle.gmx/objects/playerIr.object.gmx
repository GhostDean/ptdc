        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Initializing
//global variables:
//
//  global.frozen       set to true to make player uncontrollable
//  global.frozen2      set to true to make player unmovable
//  global.reverse      0: normal kid ; 1: reverse kid
//
//whether can infinite jump or not
infJump = false;
//first jump speed
jump[1] = 8.5;
//second jump speed
jump[2] = 7;
//maximum jump times
//you should have variables such as jump[3] if you need 3 jumps or more
maxJumps = 1;
//current jump times
curJumps = 1;
//horizontal speed
maxSpeed = 3;
//horizontal max speed
maxHspeed = 9;
//gravity ��step
onPlatform=0;
//maximum speed when falling
maxVspeed = 9;
//reverse gravity

if(global.reverse == 0){
    yflag = 1;
}
if(global.reverse == 1){
    yflag = -1;
    y -= 4;
    curJumps = 1;
}
image_yscale = yflag;
image_speed = 0.2;
//save game when playing for the 1st time
alarm[1] = 1;

Ir_meetice = false;
irfly=0;

if(room=rN3){
grav = 0.3;
}
else{
grav = 0.4;
 }
</string>
          </argument>
        </arguments>
      </action>
    </event>
