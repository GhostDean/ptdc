        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if(!other.cold){   
    telenum = other.telenum;
    other.cold = 100; 
    with(objIrTeleL){
        if(telenum = playerIr.telenum and !cold){
            cold = 100; 
            a = instance_create(x,y,playerIr);
            if(instance_exists(objIrKidShadow)){
                with(objIrKidShadow){
                    parent = a;
                }
            }
            audio_play_sound(sndIrTeleL,1,0);
        }
    }
    x = other.x;
    y = other.y;
    instance_destroy();
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
