            <kind>1</kind>
            <string>if itemNum &gt;= 0
{
    global.secretItem[itemNum] = true;
}
if itemMsg != ''
{
    with instance_create(0, 0, obj_itemObtain)
    {
        itemName = other.itemName;
        itemDesc = other.itemMsg;
        itemColor = other.itemColor;
        itemSpr = other.sprite_index;
        itemOffsetX = other.itemOffsetX;
        itemOffsetY = other.itemOffsetY;
    }
}

//save the item if autosaving items is on
if (global.autosaveSecretItems)
{
    global.saveSecretItem[itemNum] = true;
    scrSaveGame(false);
}

audio_play_sound(sndItem,0,false);
instance_destroy();
</string>
