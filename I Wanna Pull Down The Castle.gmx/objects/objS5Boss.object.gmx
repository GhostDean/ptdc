          <argument>
            <kind>1</kind>
            <string>if(global.bossItem[2]){
instance_destroy();
}else{
boss_activate=false;
image_speed = 0.2;
gravity = 0.4;


hp = 120;
maxHp = hp;
hp_max = hp;

state = 0;  //if appear or disappear
/*state instruction
-2  nothing (not kill)
-1  flash out
0   normal  (kill)
1   flash in
2   rush
3   jump
*/

nohurt = false;
hurt_count = 0;
hurt_cold = 6;
damage = 0;
hurt_alpha = 0; //hurt effect

p_x = x;
p_s = 1;

/*alarm instruction
[0] init and adjust the image_xscale
[1] image_speed = 0
[2] random the active
[3] attack start
[4] flash attack start
[5] fall to floor
[6] 
[7] 
[8] 
[9] 
[10]
[11]    Boss Defead
*/   
}
</string>
