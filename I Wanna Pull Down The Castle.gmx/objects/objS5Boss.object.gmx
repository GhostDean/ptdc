        <arguments>
          <argument>
            <kind>1</kind>
            <string>var _a,_list;

instance_create(view_xview[0],view_yview[0],objBossViewShake);
instance_create(x - 24,y + 64,objS5BossSmoke);
_a = instance_create(x + 24,y + 64,objS5BossSmoke);
_a.image_xscale = -0.1;
hspeed = 0;
audio_play_sound(sndS4Boss_Fall,0,false);
alarm[0] = 50;

_list = ds_list_create();
for(i = 0;i &lt; 19;i += 1){
    ds_list_add(_list,spike[i]);
}
ds_list_shuffle(_list);
for(i = 0;i &lt; 20;i += 2){
    a = ds_list_find_value(_list,i);
    a.alarm[0] = 6*i+1;
    
    if(i+1 == 19)break;
    a = ds_list_find_value(_list,i+1);
    a.alarm[0] = 6*i+1;
}
</string>
