    <event eventtype="4" ename="objBullet">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if(!hp)exit;
with(other)instance_destroy();
if(nohurt)exit;
nohurt = true;
audio_play_sound(sndBossHit,0,false);

damage = choose(1,1,1,1,1,1,2,2,2,3);
hp -= damage;     //random damage

a = instance_create(other.x + irandom_range(-8,8),other.y + irandom_range(-4,4),objBossHurtNum);
a.image_index = damage;  //damage number effect

hurt_alpha += 0.25;
if(hurt_alpha &gt; 0.8)hurt_alpha = 0.8; //damage red light effect

hurt_count = hurt_cold;   //hurt cold
if(hp &lt;= 0){
    state = -2; hp=0;
    sprite_index = sprS5BossDead;
    y = view_xview[0] + 480;
    for(i = 0;i &lt; 7;i += 1)alarm[i] = 0;
    with(objS5BossSpike_1)instance_destroy();
    with(objS5Boss_Bullet_1)instance_destroy();
    with(objS5Boss_Bullet_2)instance_destroy();
    if audio_is_playing(musS3Boss)audio_stop_sound(musS3Boss);
    global.bossItem[2] = 1;
    scrSaveGame(0);
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
