    <event eventtype="2" enumb="2">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if(!instance_exists(objPlayer))return(false);

pos = 0;
//active 1  :   rush
active[pos] = 1;
pos += 1;
active[pos] = 1;
pos += 1;
if(point_distance(x,y,objPlayer.x,objPlayer.y) &lt; 80){
    for(i = pos;i &lt; pos + 3;i += 1)active[i] = 1;
    pos += 3;
}

//active 2: flash
active[pos] = 2;
pos += 1;
if(point_distance(x,y,objPlayer.x,objPlayer.y) &gt; 444){
    for(i = pos;i &lt; pos + 3;i += 1)active[i] = 2;
    pos += 3;
}

//active 3: fire
active[pos] = 3;
pos += 1;
if(objPlayer.y &lt; view_yview[0] + 416){
    for(i = pos;i &lt; pos + 3;i += 1)active[i] = 3;
    pos += 3;
}

//active 4; jump
ready = true;
for(i = 0;i &lt; 19;i += 1){
    if(!spike[i].ready)ready = false;
}
if(ready){
    for(i = pos;i &lt; pos + 2;i += 1)active[i] = 4;
    pos += 2;
}

//active 5
active[pos] = 5;
pos += 1;
if(x &lt; view_xview[0] + 288 or x &gt; view_xview[0] + 512){
    for(i = pos;i &lt; pos + 1;i += 1)active[i] = 1;
    pos += 1;
}

kind = active[irandom(pos - 1)];
//show_message(string(kind))
switch(kind){
    case 1:{
        sprite_index = sprS5BossWalk;
        image_index = 0;
        image_xscale = sign(objPlayer.x - x);
        speed = sign(objPlayer.x - x)*6;
        alarm[3] = 50;
        state = 2;
    }break;
    
    case 2:{
        p_s = objPlayer.xScale;
        p_x = objPlayer.x - 32*p_s;
            p_x = max(min(p_x,view_xview[0] + 640),view_xview[0] + 160)
        state = -1;
        alarm[4] = 30;
    }break;
    
    case 3:{
        sprite_index = sprS5BossMagic;
        image_index = 0;
        image_xscale = sign(objPlayer.x - x);
        instance_create(0,0,objS5Boss_Attack_2);
        alarm[0] = 30;
    }break;
    
    case 4:{
        sprite_index = sprS5BossJump;
        image_index = 0;
        image_xscale = sign(objPlayer.x - x);
        vspeed = -10.5;
        hspeed = 3*sign(objPlayer.x - x)
        gravity = 0.35;
        alarm[1] = 30;
        alarm[5] = 60;
        audio_play_sound(sndS4Boss_Jump,0,false);
    }break;
    
    case 5:{
        sprite_index = sprS5BossMagic;
        image_index = 0;
        image_xscale = sign(objPlayer.x - x);
        instance_create(x,y-32,objS5Boss_Attack_3);
        alarm[6] = 30;
    }break;
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
