    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if(!boss_activate&amp;&amp;instance_exists(objPlayer)){
    if(objPlayer.x&lt;704&amp;&amp;objPlayer.x&gt;96){
        var a=instance_create(32,320,objBossBlock);
        a.image_yscale=3;
        a=instance_create(736,320,objBossBlock);
        a.image_yscale=3;
        audio_play_sound(musS3Boss, 0, 1);
        ready=true;
        for(i=0;i&lt;19;i++)
            spike[i]=instance_create(view_xview[0]+96+i*32,view_yview[0]+128,objS5BossSpike);
        alarm[0]=30;alarm[2]=70;
        boss_activate=true;
        scrInitHpBar(id, 2, 'Abomination');
    }
}


if(hurt_count &gt; 0){
    hurt_count -= 1;
    if(hurt_count == 0)nohurt = false;
}
if(hurt_alpha &gt; 0)hurt_alpha -= 0.015;


switch(state){
    //flash
    case -1:{
        image_xscale -= 0.1*sign(image_xscale);
        image_yscale += 0.1;
        if(abs(image_xscale) = 0){
            image_xscale = 0;
            image_yscale = 2;
            state = -2;
        }
    }break;
    
    case 1:{
        image_xscale += 0.1*sign(image_xscale);
        image_yscale -= 0.1;
        if(image_xscale &gt; sign(image_xscale)){
            image_xscale = sign(image_xscale);
            image_yscale = 1;
            state = 0;
        }
    }break;
    
    //rush
    case 2:{
        if(instance_exists(objPlayer)){
            if(abs(x - objPlayer.x) &lt; 80 and abs(x - objPlayer.x) &gt; 48){
                if(random(1) &gt; 0.3)alarm[3] = 1;
            }
        }
    }break;
}
