        <arguments>
          <argument>
            <kind>1</kind>
            <string>x=objFinalBoss.x;
y=objFinalBoss.y;
if(shake){
  view_xview=random_range(-range,range);
  view_yview=random_range(-range,range);
}
if(objFinalBoss.nowhp&lt;11){
  if(now=0){
    now=1;alarm[0]=-1;
    alarm[1]=50;
  }
}
if(objFinalBoss.nowhp&lt;6){
  if(now=1){
    now=2;alarm[1]=-1;
    alarm[2]=120;
  }
}
if(objFinalBoss.nowhp&lt;1){
  if(now=2){
    now=3;alarm[2]=-1;
    alarm[3]=50;
  }
}
if(!instance_exists(objPlayer)){
  var i;
  for(i=0;i&lt;10;i+=1){
    alarm[i]=-1;
  }
}
</string>
          </argument>
        </arguments>
      </action>
