          <argument>
            <kind>1</kind>
            <string>polygonShoot(5,25,objFBdm,5,0,random(360),sprFBdm7)
audio_playsound(sndFBshoot);
with(objFBdm){
  ima=1;
}
count+=1;
if(count&lt;3){
  alarm[0]=40;
}else{
  instance_create(400,562,objFBshootspk);
  alarm[1]=40;
  objFinalBoss.change_col=false;
}
