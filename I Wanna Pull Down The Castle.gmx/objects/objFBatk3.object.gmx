    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>x=objFinalBoss.x;
y=objFinalBoss.y;
if(shake){
  view_xview=random_range(-range,range);
  view_yview=random_range(-range,range);
}
if(objFinalBoss.nowhp&lt;21){
  if(now=0){
    now=1;alarm[2]=-1;
    alarm[3]=50;stage=0;
    a=instance_create(x,y,objFBshoot5);
    a.hspeed=-5;
    a=instance_create(x,y,objFBshoot5);
    a.hspeed=5;
  }
}
if(objFinalBoss.nowhp&lt;11){
  if(now=1){
    now=2;alarm[3]=-1;
    alarm[4]=50;
    with(objFBshoot5)instance_destroy();
  }
}
if(objFinalBoss.nowhp&lt;1){
  if(now=2){
    now=3;alarm[4]=-1;
    alarm[5]=100;count=0;
    objFBshootspk.des=1;
  }
}
if(instance_exists(objPlayer)){
    if(objPlayer.y&gt;628&amp;&amp;!global.infJump){
        var b=instance_create(0,576,block);
        b.image_xscale=25;
        global.infJump=true;
    }
}else{
  var i;
  for(i=0;i&lt;12;i+=1){
    alarm[i]=-1;
  }
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
