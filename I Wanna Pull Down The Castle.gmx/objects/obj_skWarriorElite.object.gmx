    <event eventtype="7" enumb="7">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if sprite_index == skWarriorDead instance_destroy();
else if sprite_index == skWarriorDamaged
{
    damaged = false;
}
else if sprite_index == skWarriorAttack
{
    if curAttackMode == 2
    {
        mask_index = -1;
        image_alpha = 1;
        invisible = 0;
        invisibleTimer = 0;
        invX = 0;
        invY = 0;
    }
    mask.hspeed = 0;
    curAttackMode = -1;
    attacking = false;
    alarm[0] = irandom_range(10, 30);
}
else if sprite_index == skWarriorSpell
{
    switch curAttackMode
    {
        case 1:
            image_index = 3;
            image_speed = 0;
            if !spellOn
            {
                spellOn = 1;
            }
            break;
        case 2:
            image_index = 3;
            image_speed = 0;
            invisible = 1;
            break;
        case 3:
            curAttackMode = -1;
            alarm[0] = random_range(10, 30);
            audio_play_sound(sndBlockChange, 0, 0);
            instance_create(random_range(128, 640), 480, obj_skWarriorSummonSword);
            break;
    }
}
</string>
          </argument>
        </arguments>
      </action>
