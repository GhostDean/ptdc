      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if damaged return -1;
if attacking return -1;
if hp == 0 return -1;
if !scrCheckPlayerExists() exit;

if !active
{
    scrFollowPlayerDirecton();
    image_xscale = sign(image_xscale) * 1.5;
    scrChangeImage(skWarriorIdle, .1);
    active = scrPlayerInRectangle(x,y-rectOffsetY,rectWidth*image_xscale,rectHeight);
}
else
{
    if curAttackMode == -1
    {
        curAttackMode = irandom(3);
    }
    else
    {
        switch curAttackMode
        {
            case 0:
                var _dist = scrPlayerDistance();
                if _dist &lt; attackRange &amp;&amp; sprite_index != skWarriorAttack
                {
                    attacking = true;
                    mask.hspeed = 0;
                    scrChangeImage(skWarriorAttack, .8);
                }
                else
                {
                    scrFollowPlayerDirecton();
                    image_xscale = sign(image_xscale) * 1.5;
                    scrBasicEnemyMovement(moveSpeed * 2);
                    scrChangeImage(skWarriorWalk, .2);
                }
                break;
            case 1:
                scrChangeImage(skWarriorSpell, .1);
                if spellOn
                {
                    spellTimer++;
                    if spellTimer &gt;= 250
                    {
                        spellTimer = 0;
                        spellOn = 0;
                        curAttackMode = -1;
                        scrChangeImage(skWarriorIdle, .1);
                        alarm[0] = irandom_range(10, 30);
                    }
                    if spellTimer mod 10 == 0
                    {
                        instance_create(random_range(160,640), 288, obj_skWarriorSword);
                    }
                }
                break;
            case 2:
                if !invisible
                {
                    scrChangeImage(skWarriorSpell, .1);
                }
                else
                {
                    invisibleTimer++;
                    if image_alpha &gt; 0 &amp;&amp; invisibleTimer &lt; 140
                    {
                        image_alpha -= .1;
                        if image_alpha == 0 mask_index = sprMaskNothing;
                    }
                    if invisibleTimer == 90
                    {
                        invX = objPlayer.x;
                        invY = objPlayer.y;
                        with instance_create(invX, invY, obj_shadow)
                        {
                            scrFollowPlayerDirecton();
                            image_xscale *= 1.5;
                            type = 0;
                            sprite_index = other.skWarriorSpell;
                            image_index = 3;
                            image_speed = 0;
                            image_alpha = .3;
                            depth = -100;
                        }
                    }
                    if invisibleTimer == 100
                    {
                        scrFollowPlayerDirecton();
                        image_xscale = sign(image_xscale) * 1.5;
                        image_alpha = 1;
                        mask.x = invX;
                        mask.y = invY;
                        mask_index = -1;
                        scrChangeImage(skWarriorAttack, .8);
                        image_index = 3;
                    }
                }
                break;
            case 3:
                scrChangeImage(skWarriorSpell, .1);
                break;
            default:
                mask.hspeed = 0;
                scrChangeImage(skWarriorIdle, .1);
        }
    }
}
</string>
          </argument>
        </arguments>
      </action>
