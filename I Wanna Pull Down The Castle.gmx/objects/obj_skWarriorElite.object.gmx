        <arguments>
          <argument>
            <kind>1</kind>
            <string>mask = instance_create(x, y, obj_movementMask);
mask.sprite_index = sprSkWarriorNormalMask;
mask.image_xscale = 1.5;
mask.image_yscale = 1.5;

image_speed = .1;
mask.gravity = .4;

hp = 25;
hpmax = hp;
skWarriorIdle = sprSkWarriorNormalIdle;
skWarriorWalk = sprSkWarriorNormalWalk;
skWarriorAttack = sprSkWarriorNormalAttack;
skWarriorDamaged = sprSkWarriorNormalDamaged;
skWarriorDead = sprSkWarriorNormalDead;
skWarriorSpell = sprSkWarriorNormalReady;

radius = 0;
rectOffsetY = 50;
rectWidth = 200;
rectHeight = 60;

// 攻击模式一览
// 0: 加速到攻击范围，走路有残影，挥刀攻击
// 1: 举起刀，召唤剑攻击，持续5秒
// 2: 隐身，过2秒移动到玩家位置，攻击。第1.8秒透明度从0
// 变成0.3
// 3: 在随机位置召唤一把剑（地上），剑每隔5秒会在顶端
// 召唤一把剑，锁定player，等待3秒后攻击，地上的剑血量
// 为4，最多存在3把召唤剑
curAttackMode = -1;

effectTimer = 0;

spellOn = 0;
spellTimer = 0;

invisible = 0;
invisibleTimer = 0;
invX = 0;
invY = 0;

attacking = false;
attackRange = 70; // radius
damaged = false;

moveSpeed = 1.5;

image_xscale = 1.5; image_yscale = 1.5;
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="2" enumb="0">
