{
    if !blocking &amp;&amp; blockIntervalTimer == 0
    {
        blocking = 1;
        blockTimer = blockTime;
        image_index = 11;
        image_speed = 0;
    }
}
else if sprite_index == skWarriorDamaged
{
    damaged = false;
}
else if sprite_index == skWarriorAttack
{
    if scrPlayerDistance() &lt;= attackRange
    {
        sprite_index = skWarriorAttack;
