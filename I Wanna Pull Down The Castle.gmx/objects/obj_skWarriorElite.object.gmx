        <arguments>
          <argument>
            <kind>1</kind>
            <string>if !active return -1;

if blocking
{
    if image_xscale == -1
    {
        if other.x &gt;= x event_inherited();
    }
    else if image_xscale == 1
    {
        if other.x &lt;= x event_inherited();
    }
    with other instance_destroy();
}
else
{
    event_inherited();
    if blockTimer == 0 &amp;&amp; blockIntervalTimer == 0
    {
        hspeed = 0;
        scrChangeImage(skWarriorBlock, .4);
    }
}
</string>
