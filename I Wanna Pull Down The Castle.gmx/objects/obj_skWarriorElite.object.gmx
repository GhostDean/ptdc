        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Effect
switch curAttackMode
{
    case 0:
        if effectTimer == 0
        {
            effectTimer = 2;
            scrCreateShadow(0, image_blend);
        }
        break;
}

if effectTimer &gt; 0
{
    effectTimer--;
}
</string>
