        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Decide next action
mask.hspeed = 0;
curAttackMode = irandom(3);

if curAttackMode == 3 &amp;&amp; instance_number(obj_skWarriorSummonSword) == 3
{
    curAttackMode = irandom(2);
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
