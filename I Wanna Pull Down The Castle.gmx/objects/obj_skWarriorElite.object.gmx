        <arguments>
          <argument>
            <kind>1</kind>
            <string>if damaged return -1;
if attacking return -1;
if hp == 0 return -1;

if active
{
    if blocking
    {
        if hspeed != 0 hspeed = 0;
        blockTimer--;
        if blockTimer == 0
        {
            scrChangeImage(skWarriorIdle, .1);
            blocking = false;
            blockIntervalTimer = blockInterval;
        }
    }
    else
    {
        if sprite_index == skWarriorBlock return -1;
        scrFollowPlayerDirecton();
        image_xscale = sign(image_xscale) * 1.5;
        scrBasicEnemyMovement(moveSpeed);
        scrChangeImage(skWarriorWalk, .2);
        if scrPlayerDistance() &lt;= attackRange
        {
            hspeed = 0;
            attacking = 1;
            scrChangeImage(skWarriorAttack, .6);
        }
    }
}
else
{
    if patrol
    {
        if hspeed == 0
        {
            hspeed = moveSpeed * image_xscale;
            sprite_index = skWarriorWalk;
            image_speed = .2;
        }
    }
    else
    {
        scrFollowPlayerDirecton();
        image_xscale = sign(image_xscale) * 1.5;
        if sprite_index != skWarriorIdle
        {
            sprite_index = skWarriorIdle;
            image_index = 0;
            image_speed = .1;
        }
    }
    active = scrPlayerInRectangle(x,y-rectOffsetY,rectWidth*image_xscale,rectHeight);
    if active patrol = false;
}
</string>
          </argument>
