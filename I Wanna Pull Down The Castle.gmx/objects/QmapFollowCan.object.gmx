        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Draw map to surface
if !surface_exists(global.surfMap)
{
    global.surfMap = surface_create(600, 480);
}

surface_set_target(global.surfMap);
draw_clear_alpha(c_black, 0);
for (var xx = 0; xx &lt; 40; xx++)
{
    for (var yy = 0; yy &lt; 30; yy++)
    {
        if global.map[xx, yy]
        {
            draw_sprite_part(sprQ_map, 0, 16 * xx, 16 * yy, 16, 16, 16*xx, 16*yy);
        }
    }
}
surface_reset_target();
</string>
