          <argument>
            <kind>1</kind>
            <string>if instance_number(QmapFollowCan) &gt; 1
{
    instance_destroy();
}
if(scrSViewRoom()){
    if(instance_exists(objPlayer)){
        x=(objPlayer.x div view_wview[0])*view_wview[0];
        y=(objPlayer.y div view_hview[0])*view_hview[0];
        view_xview[0]=x;
        view_yview[0]=y;
    }
}else{
if(instance_exists(objPlayer))
{
    x = objPlayer.x;
    y = objPlayer.y;
}

if(x &lt; view_wview[0]/2)
{
    x = view_wview[0]/2;
}
if(x &gt; room_width - view_wview[0]/2) 
{
    x = room_width - view_wview[0]/2;
}
if(y &lt; view_hview[0]/2) 
{
    y = view_hview[0]/2;
}
if(y &gt; room_height - view_hview[0]/2) 
{
    y = room_height - view_hview[0]/2;
}

view_xview[0] = round(x - (view_wview[0]/2));
view_yview[0] = round(y - (view_hview[0]/2));
}
curRoomX = 0;
curRoomY = 0;

displayMap = 0;
c_deepblue = make_colour_rgb(0, 0, 125);
</string>
