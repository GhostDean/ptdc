    <event eventtype="8" enumb="64">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if instance_exists(obj_portal)
{
    if obj_portal.activate exit;
}

if !scrCheckPlayerExists() exit;

if displayMap
{
    if !surface_exists(global.surfMap)
    {
        global.surfMap = surface_create(600, 480);
        event_user(0);
    }
    // draw deep blue background
    draw_set_colour(c_deepblue);
    draw_set_alpha(144/255);
    draw_rectangle(80, 64, 80+640, 64+480, 0);
    draw_set_alpha(1);
    draw_set_colour(c_white);
    // draw map surface
    draw_surface(global.surfMap, 80, 64);
    // draw kid head
    draw_sprite(sprQ_mapHead, 0, 82+16*curRoomX, 67+16*curRoomY);
    // draw exploration progress
    draw_set_font(fntPixel21);
    draw_text(80+32, 64+32, 'Map Progress: ' + string_format(global.exploredMapChunks / global.totalMapChunks * 100, 3, 2) + '%');
    draw_set_font(fDefault12);
}
else
{
    var xx = min(max(0, curRoomX-2), 35);
    var yy = min(max(0, curRoomY-1), 26);
    
    // draw minimap background
    draw_set_colour(c_deepblue);
    draw_set_alpha(144/255);
    draw_rectangle(706, 12, 706+82, 12+50, 0);
    draw_set_alpha(1);
    draw_set_colour(c_white);
    // draw minimap chunk
    for (var i = 0; i &lt; 5; i++)
    {
        for (var j = 0; j &lt; 3; j++)
        {
            if global.map[xx + i, yy + j]
            {
                draw_sprite_part(sprQ_map, 0, 16*(xx+i), 16*(yy+j), 16, 16, 706+16*i, 12+16*j);
            }
        }
    }
    shader_set(Q_MapCenter);
    draw_sprite_part(sprQ_map, 0, 16*curRoomX, 16*curRoomY, 16, 16, 738+16*(curRoomX-xx-2), 28+16*(curRoomY-yy-1));
    draw_sprite(sprQ_mapHead, 0, 740+16*(curRoomX-xx-2), 31+16*(curRoomY-yy-1));
    shader_reset();
}
</string>
