            <string>/// Check whether discover new map chunk
if (curRoomX == 0 &amp;&amp; curRoomY == 0) exit;
if(!global.map[curRoomX, curRoomY])
{
    global.exploredMapChunks++;
    global.map[curRoomX, curRoomY] = true;
    event_user(0);// redraw the map surface
}
