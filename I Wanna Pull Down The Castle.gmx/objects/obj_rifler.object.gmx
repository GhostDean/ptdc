            <kind>1</kind>
            <string>if hp &gt; 0
{
    if !active
    {
        if !patrol scrChangeImage(sprRiflerIdle, .1);
        active = scrPlayerInRectangle(x,y-rectOffsetY,rectWidth*image_xscale,rectHeight);
    }
    else
    {
        if patrol
        {
            hspeed = 0;
            patrol = 0;
        }
        scrFollowPlayerDirecton();
    
        if !shot
        {
            with instance_create(x+33*image_xscale,y-46,obj_riflerBullet)
            {
                if instance_exists(objPlayer)
                    direction = point_direction(x,y,objPlayer.x,objPlayer.y);
                speed = 8;
                image_angle = direction;
            }
            scrChangeImage(sprRiflerShoot, .1);
            shot = 1;
        }
    }
}
</string>
