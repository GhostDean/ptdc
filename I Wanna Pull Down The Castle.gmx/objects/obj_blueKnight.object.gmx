        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>switch curState
{
    case STATE_CAST:
        curState = STATE_BLINK;
        castDid = 0;
        break;
    case STATE_NORMAL_ATTACK:
        curState = STATE_BLINK;
        break;
    case STATE_SPECIAL:
        scrChangeImage(sprBKIdle, 0);
        specialAnimEnd = 1;
        break;
    case STATE_BLINK:
        image_alpha = 0;
        x = random_range(96, 704);
        scrFollowPlayerDirecton();
        curState = STATE_IDLE;
        alarm[0] = random_range(30, 50);
        break;
    case STATE_DEAD:
        if sprite_index == sprBKDisappear
        {
            instance_destroy();
        }
        break;
}
</string>
