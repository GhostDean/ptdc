        <arguments>
          <argument>
            <kind>1</kind>
            <string>if hp == 0 exit;
hp--;
with other instance_destroy();
if hp &gt; 0
{
    audio_play_sound(sndBossHit2, 0, 0);
    image_blend = c_red;
    alarm[11] = 5;
}
else
{
    with obj_bkSpike instance_destroy();
    with obj_bkThunder instance_destroy();
    with obj_bkWarning instance_destroy();
    audio_play_sound(sndDeath, 0, 0);
    audio_stop_sound(musBlueKnight);
    curState = STATE_DEAD;
    scrChangeImage(sprBKDisappear, .3);
    global.bossItem[1] = 1;
    scrSaveGame(0);
}
</string>
          </argument>
        </arguments>
      </action>
