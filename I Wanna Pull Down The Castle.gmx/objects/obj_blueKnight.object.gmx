        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Define States
STATE_IDLE = 1;
STATE_NORMAL_ATTACK = 2;
STATE_SPECIAL = 3;
STATE_BLINK = 4;
STATE_WALK = 5;
STATE_DEAD = 6;
STATE_CAST = 7;

// state variables
// walk
walkPosX = x;
walkSpeed = 9;
// cast
castDid = 0;
castTimer = 0;
castCooldown = 200;
castSpikePos = ds_list_create();
// normal attack
normalAttackRadius = 50;
// special
specialDid = 0;
specialTimer = 0;
specialAnimEnd = 0;

event_user(0);
curState = STATE_BLINK;
</string>
          </argument>
        </arguments>
      </action>
