            <kind>1</kind>
            <string>if audio_is_playing(musBlueKnight)
{
    audio_stop_sound(musBlueKnight);
}
with objSpikeDown instance_destroy();
with objSpikeUp instance_destroy();
global.bossItem[1] = 1;
ds_list_destroy(castSpikePos);
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="2" enumb="11">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
