    <event eventtype="2" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Decide next attack
if hp == 0 exit;
if !instance_exists(objPlayer) exit;
while 1
{
    curState = choose(STATE_WALK, STATE_CAST, STATE_NORMAL_ATTACK);
    if hp &lt; maxHp / 2 &amp;&amp; !specialDid
    {
        specialDid = 1;
        curState = STATE_SPECIAL;
    }
    switch curState
    {
        case STATE_WALK:
            scrChangeImage(sprBKWalk, .3);
            walkPosX = objPlayer.x;
            image_xscale = sign(walkPosX - x);
            break;
        case STATE_CAST:
            if ds_list_size(castSpikePos) &lt; 3 || castTimer != 0
            {
                continue;
            }
            scrChangeImage(sprBKCast, .3);
            break;
        case STATE_NORMAL_ATTACK:
            if scrPlayerDistance() &gt; normalAttackRadius
            {
                continue;
                break;
            }
            scrFollowPlayerDirecton();
            scrChangeImage(sprBKAttack, .3);
            break;
        case STATE_SPECIAL:
            scrChangeImage(sprBKAttack2, .3);
            specialTimer = 0;
            specialAnimEnd = 0;
            break;
    }
    break;
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>switch curState
{
    case STATE_IDLE:
        scrChangeImage(sprBKIdle, 0);
        break;
    case STATE_WALK:
        scrCreateShadow(0, c_white);
        if walkPosX &gt; x
        {
            x = min(x + walkSpeed, walkPosX);
        }
        else if walkPosX &lt; x
        {
            x = max(x - walkSpeed, walkPosX);
        }
        else
        {
            curState = STATE_BLINK;
        }
        break;
    case STATE_CAST:
        if !castDid
        {
            if image_index &gt;= 4 &amp;&amp; image_index &lt; 5
            {
                audio_play_sound(sndBlockChange, 0, 0);
                castTimer = castCooldown;
                castDid = 1;
                repeat(3)
                {
                    var ind = irandom_range(0, ds_list_size(castSpikePos)-1);
                    instance_create(castSpikePos[| ind], 512, obj_bkSpike);
                    ds_list_delete(castSpikePos, ind);
                }
            }
        }
        break;
    case STATE_SPECIAL:
        if specialAnimEnd
        {
            specialTimer++;
            if specialTimer == 200
            {
                curState = STATE_BLINK;
                exit;
            }
            if specialTimer mod 12 == 0
            {
                instance_create(irandom_range(64+16, 736-16), 544, obj_bkWarning);
            }
        }
        break;
    case STATE_BLINK:
        scrChangeImage(sprBKDisappear, .2);
        break;
}
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
