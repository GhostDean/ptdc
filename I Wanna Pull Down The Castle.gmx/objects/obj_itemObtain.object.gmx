            <string>if !surface_exists(surf)
{
    surf = surface_create(800, 608);
}
else
{
    draw_surface(surf, 0, 0);
    draw_set_font(fntPixel25);
    draw_set_alpha(itemNameAlpha);
    draw_set_colour(c_white);
    draw_set_halign(1);
    draw_set_valign(1);
    draw_text(400, 100, 'Item Obtained:');
    draw_set_colour(itemNameColor);
    draw_set_font(fntPixel25);
    draw_text(400, 130, itemName);
    draw_set_colour(c_white);
    draw_set_halign(fa_left);
    draw_set_valign(fa_top);
    draw_set_font(fntPixel21);
    draw_text(300, 170, showItemDesc);
    draw_set_alpha(1);
    draw_set_font(fDefault12);
}
</string>
