    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>switch kind
{
    case 0:
        if animRadiusTimer &lt; animRadiusTime
        {
            animRadiusTimer++;
        }
        if kidItemAlpha &lt; 1 kidItemAlpha += .05;
        if musicVolume &gt; 0
        {
            musicVolume = max(musicVolume - 2, 0);
            audio_sound_gain(global.currentMusicID, musicVolume/100, 0);
        }
        kidOffset = EaseLinear(animRadiusTimer / animRadiusTime, 0, kidOffsetTarget, 1);
        curRadius = EaseOutBack(animRadiusTimer / animRadiusTime, initRadius, targetRadius, 1);
        if curRadius == targetRadius
        {
            kind = 1;
            animRadiusTimer = 0;
        }
        break;
    case 1:
        if itemNameAlpha == 0 audio_play_sound(sndItemGet, 0, 0);
        if itemNameAlpha &lt; 1 itemNameAlpha += .05;
        
        if textDelay == 0
        {
            if textIndex &lt;= string_length(itemDesc)
            {
                textDelay = 3;
                showItemDesc += string_copy(itemDesc, textIndex++, 1);
            }
            else
            {
                waitTimer++;
                if waitTimer == 150
                {
                    kind = 2;
                }
            }
        }
        else
        {
            textDelay--;
        }
        break;
    case 2:
        if animRadiusTimer &lt; animRadiusTime
        {
            animRadiusTimer++;
        }
        
        if musicVolume &lt; 100
        {
            musicVolume = min(musicVolume + 2, 100);
            audio_sound_gain(global.currentMusicID, musicVolume/100, 0);
        }
        
        kidOffset = EaseLinear(animRadiusTimer / animRadiusTime, kidOffsetTarget, 0, 1);
        itemNameAlpha -= 1 / animRadiusTime;
        kidItemAlpha = itemNameAlpha;
        curRadius = EaseInBack(animRadiusTimer / animRadiusTime, targetRadius, initRadius, 1);
        if curRadius == initRadius
        {
            instance_destroy();
            disabled = 1;
        }
        break;
}
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Draw Surface
if instance_exists(objPlayer) &amp;&amp; surface_exists(surf)
{
    surface_set_target(surf);
    draw_clear(c_black);
    draw_set_blend_mode(bm_subtract);
    draw_set_color(c_white);
    draw_set_alpha(1);
    draw_circle(objPlayer.x, objPlayer.y, curRadius, 0);
    draw_set_blend_mode(bm_normal);
    surface_reset_target();
}
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Set kid var
if disabled exit;
if scrCheckPlayerExists()
{
    with objPlayer
    {
        inGettingItem = 1;
        gottenItemSpr = other.itemSpr;
        gottenItemOffset = other.kidOffset;
        gottenItemAlpha = other.kidItemAlpha;
        gottenItemOffX = other.itemOffsetX;
        gottenItemOffY = other.itemOffsetY;
    }
}
</string>
