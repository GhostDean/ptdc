        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>h=false;spd=2;
move=false;
ptop=instance_create(x,y,objS2LiftP)
pbot=instance_create(x,y+96,objS2LiftP)
for (var i=0;i&lt;2;i++)
{
    liftBlock[i] = instance_create(x, y+100*i, objBlock);
    liftBlock[i].image_xscale = 3;
}
liftBlock[1].image_yscale=28/32;
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="2">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if !instance_exists(objPlayer) exit;
if(move){
    if(objPlayer.x&lt;x){
        scrKillPlayer();
        exit
        //objPlayer.x=x+8;objPlayer.hspeed=0;
    }
    if(objPlayer.x&gt;x+96){
        scrKillPlayer();
        exit
        //objPlayer.x=x+88;objPlayer.hspeed=0;
    }
    if(objPlayer.y&lt;y+45){
        objPlayer.y=y+45+vspeed;
        objPlayer.vspeed=vspeed;
    }
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="1">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if !instance_exists(objPlayer) exit;
if(objPlayer.x&gt;x+8&amp;&amp;objPlayer.x&lt;x+88 &amp;&amp; objPlayer.y &gt;= y+32 &amp;&amp; objPlayer.y &lt;= y + 95){
    if(!move){
        if(scrButtonCheck(global.upButton)){
            if(h){
                hspeed=-spd
            }else{
                vspeed=-spd
            }
            move=true;
        }else if(scrButtonCheck(global.downButton)){
            if(h){
                hspeed=spd
            }else{
                vspeed=spd
            }
            move=true;
        }
    }
}
if(move){
    if(place_meeting(x+hspeed,y, objLiftStopBlock) || place_meeting(x+hspeed, y, objS2Lift) || place_meeting(x+hspeed, y, objQS4Stone1)){
        hspeed=0;move=0;
    }
    if(place_meeting(x,y+vspeed, objLiftStopBlock) || place_meeting(x, y+vspeed, objS2Lift) || place_meeting(x+hspeed, y, objQS4Stone1)){
        vspeed=0;move=0;
    }
    if(objPlayer.x&lt;x){
        scrKillPlayer();
        exit
        //objPlayer.x=x+8;objPlayer.hspeed=0;
    }
    if(objPlayer.x&gt;x+96){
        scrKillPlayer();
        exit
        //objPlayer.x=x+88;objPlayer.hspeed=0;
    }
    if(objPlayer.y&lt;y+45+vspeed){
        objPlayer.y=y+45+vspeed;
        objPlayer.vspeed=vspeed;
    }
    ptop.hspeed=hspeed;
    ptop.vspeed=vspeed;ptop.yspeed=0;
    pbot.hspeed=hspeed;pbot.yspeed=0;
    pbot.vspeed=vspeed;
}else{
    ptop.hspeed=0;
    ptop.vspeed=0;ptop.yspeed=0;
    pbot.hspeed=0;pbot.yspeed=0;
    pbot.vspeed=0;
}

for (var i = 0; i &lt; 2; i++)
{
    liftBlock[i].x = x;
    liftBlock[i].y = y + 100 * i;
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
