        <arguments>
          <argument>
            <kind>1</kind>
            <string>sys = part_system_create();
part_system_depth(sys,1000);

part1 = part_type_create(); 

part_type_sprite(part1,sprFBeffire,0,0,1);
part_type_size(part1,2,3,-0.01,0);
part_type_orientation(part1,0,360,2,0,0);
part_type_alpha3(part1,0.1,0.4,0);
part_type_blend(part1,1);
    

part_type_direction(part1,85,95,0,0);
part_type_speed(part1,5,10,0,0);

part_type_life(part1,10,15);

part2 = part_type_create();
part_type_shape(part2,pt_shape_flare);
part_type_size(part2,0.40,1.00,0.08,0);
part_type_scale(part2,1.55,1.29);
part_type_alpha3(part2,0.2,0.12,0);
part_type_speed(part2,1.5,2,0.5,2);
part_type_direction(part2,85,95,0,7);
part_type_gravity(part2,0,270);
part_type_orientation(part2,64,129,-0.60,6,0);
part_type_blend(part2,0);
part_type_life(part2,10,15);

