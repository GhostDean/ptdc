            <kind>1</kind>
            <string>part_type_color1(global.dm_fire,objFinalBoss.image_blend);
if(instance_exists(objFinalBoss)){
  part_type_color1(part1,global.FBcol);
  part_emitter_region(sys,emitter1,objFinalBoss.x-objFinalBoss.sprite_width/2,objFinalBoss.x+objFinalBoss.sprite_width/2,objFinalBoss.y,objFinalBoss.y+objFinalBoss.sprite_height/2,ps_shape_ellipse,ps_distr_gaussian);
  part_emitter_burst(sys,emitter1,part1,10);
}
time+=1;
if(time=3){
  part_type_color1(part2,global.FBcol);
  var ang,xx,yy;
  for(ang=180;ang&gt;0;ang-=5){
    xx=centerX+lengthdir_x(400,ang);
    yy=centerY+lengthdir_y(400,ang);
    part_emitter_region(sys,emitter2,xx,xx,yy,yy,ps_shape_line,ps_distr_linear);
    part_emitter_burst(sys,emitter2,part2,1);
  }
  time=0;
}
