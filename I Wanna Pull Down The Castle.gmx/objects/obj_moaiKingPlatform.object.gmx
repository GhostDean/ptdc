{
    hsp = lengthdir_x(_dist, _dir);
    vsp = lengthdir_y(_dist, _dir);
}
hsp += xspeed;
yspeed = vsp;

if place_meeting(x, y - 2, objPlayer)
{
    with objPlayer
    {
        y += vsp;
        if place_free(x + hsp, y)
        {
            x += hsp + other.xspeed;
        }
    }
}
