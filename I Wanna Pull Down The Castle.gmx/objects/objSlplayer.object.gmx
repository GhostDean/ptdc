    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if(!frozen){
var i,j,d;
var L=(scrButtonCheck(global.leftButton)||(global.directionalTapFix &amp;&amp; scrButtonCheckPressed(global.leftButton)));
var R=(scrButtonCheck(global.rightButton)||(global.directionalTapFix &amp;&amp; scrButtonCheckPressed(global.rightButton)));
var h=R;
if(h==0)h=-L;
if(h!=0){vx=h*spd;image_xscale=h}else{vx=0}
if(shootinterval)shootinterval-=1
if(scrButtonCheckPressed(global.shootButton))scrPlayerShoot();
if(scrButtonCheckPressed(global.jumpButton)){
    if(place_free(x,y+step)){
        if(djump){
            vy=-jump2;djump=0;
            audio_play_sound(sndDJump,0,false);
        }
    }else{
        vy=-jump1;djump=1;audio_play_sound(sndJump,0,false);
    }
}
if(scrButtonCheckReleased(global.jumpButton) &amp;&amp; vy&lt;0)vy*=0.45;
vy+=g;
if(vy&gt;maxVspd)vy=maxVspd;
h=sign(vx);
if(h!=0){
    for(i=1;i&lt;=abs(vx);i++){
        if(place_free(x,y+step)){
            if(place_free(x+h,y))x+=h;
        }else{
            if(place_free(x+h,y)){
                if(!place_free(x+h,y+1)){x+=h}
                else{
                    for(j=1;j&lt;=step;j++){
                        if(!place_free(x+h,y+j+1)&amp;&amp;place_free(x+h,y+j))break;
                    }
                    if(j&lt;=step){
                        if(h==1){d=arctan(i)}else{d=pi-arctan(i)}
                        x+=cos(d);y+=sin(d);
                    }else{x+=h}
                }
            }else{
                for(j=1;j&lt;=step;j++){
                    if(!place_free(x+h,y-j+1)&amp;&amp;place_free(x+h,y-j))break;
                }
                if(j&lt;=step){
                    if(h==1){d=arctan(i)}else{d=pi-arctan(i)}
                    x+=cos(d);y-=sin(d);
                }else{break}
            }
        }
    }
}
h=sign(vy);
if(vy&gt;0){h=min(h,vy)}else if(vy&lt;0){h=max(h,vy)}
if(h!=0){
    if(place_free(x,y+vy)){y+=vy}
    else{
        while(place_free(x,y+h))y+=h;
        vy=0;
        if(h&gt;0){
            var i;
            for(i=0;i&lt;12;i++){
                if(!place_free(x,y)){y-=1}else{break}
            }
            if(!place_free(x,y))killSlplayer();
        }
    }
}
if(!place_free(x,y+step)){
    if(vx!=0){
        sprite_index=sprSlRunning;
        image_speed=0.4;
        image_xscale=sign(vx);
    }else{
        sprite_index=sprSlIdle;
        image_speed=0.2;
    }
    djump=1;
}else{
    if(vy&lt;0){sprite_index=sprSlJump}
    else if(vy&gt;0){sprite_index=sprSlFall}
}
}else{
    speed=0;gravity=0;vy=0;
    if(!visible&amp;&amp;keyboard_check_pressed(ord("X"))){
        alarm[0]=10;
        with(objSllight){
            if(on){
                alarm[0]=1;count=0;
                on=false;xx=x;yy=y;
                hspd=(objSlplayer.x-x)/10;
                vspd=(objSlplayer.y-y)/10;
            }
        }
    }
}
if(keyboard_check_pressed(ord("X"))&amp;&amp; visible){
    var o=instance_place(x,y,objSlLP);
    if(o){
        var a=o.obj;
        if(!a.on){
            frozen=true;visible=false;
            a.alarm[0]=1;a.count=0;
            a.xx=x;a.yy=y;
            a.hspd=(a.x-x)/10;
            a.vspd=(a.y-y)/10;
            a.on=true;
        }
    }
}
if(place_meeting(x,y,objPlayerKiller))killSlplayer();
</string>
          </argument>
        </arguments>
      </action>
