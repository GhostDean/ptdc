hpPer=objFinalBoss.nowhp/objFinalBoss.maxhp;
hpLen=hpPer*650;
if(displayLen&gt;hpLen){
  displayLen-=2;
}
if(displayLen&lt;hpLen){
  displayLen = hpLen;
}
if(len/650&gt;=hpPer){
