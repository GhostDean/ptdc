  scale=(time mod 15)*0.01;
  draw_sprite_ext(sprite_index,1,x-scale*650/2/2,y-scale*16/2*2,1+scale/2,1+scale*2,0,global.FBcol,(0.15-scale)*2);
}
draw_set_blend_mode(bm_normal);
</string>
