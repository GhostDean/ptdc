if(instance_exists(objSlplayer)&amp;&amp;objSlplayer.visible){
if(draw&gt;51||draw&lt;2){
    px=objSlplayer.x;py=objSlplayer.y;
    dir=point_direction(x,y,px,py);
}
}
xx=x+lengthdir_x(r,dir);
yy=y+lengthdir_y(r,dir);
if(instance_exists(objSlplayer)&amp;&amp;objSlplayer.visible){
if(collision_line(xx,yy,px,py,objBlock,0,0)){
    if(r&gt;0)r-=0.1;draw=0;
}else{
    if(r&lt;4)r+=0.1;
    if(draw==0)draw=150;
    draw-=1;
    if(draw&gt;50)len=point_distance(xx,yy,px,py)
    if(draw&lt;=50&amp;&amp;draw&gt;0){
        if(draw==50){
            if(collision_line(xx,yy,px,py,objSlshadow,0,0)){
                var tpx=x;var tpy=y;var n=0;
                mask_index=sprSleyeMask;
                var h=cos(degtorad(dir));
                var v=-sin(degtorad(dir));
                while(!instance_place(x,y,objSlshadow)&amp;&amp;n&lt;len){
                    x+=h;y+=v;n+=1;
                }
                var o=instance_place(x,y,objSlshadow);
                cx=x;cy=y;x=tpx;y=tpy;
                if(o.image_yscale&gt;10){
                    if(!place_meeting(cx-h,cy,o)){h=-h;
                    }
                    if(!place_meeting(cx,cy-v,o)){
                        v=-v;
                    }
                    cx2=cx+h*320;
                    cy2=cy+v*320;
                }else{
                    var tpdir=o.image_angle*2-dir;
                    cx2=cx+lengthdir_x(320,tpdir);
                    cy2=cy+lengthdir_y(320,tpdir);
                }
                mask_index=sprSleye;
                var o=collision_line(cx,cy,cx2,cy2,objSleye,0,0);
                if(o!=noone){
                    with(o){if(eye&amp;&amp;alarm[0]&lt;0)alarm[0]=12}
                }
                drawc=1;
            }else{drawc=0}
        }
        if(drawc){
            if(collision_line(cx,cy,cx2,cy2,objSlplayer,0,0)){
                killSlplayer()
            }
        }else{killSlplayer()}
    }
}
}
}
