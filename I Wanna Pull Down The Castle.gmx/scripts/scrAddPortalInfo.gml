// teleName: 当前传送点的名称
// mapX: 目标房间在地图坐标轴上的位置（X坐标）
// mapY: 目标房间在地图坐标轴上的位置（Y坐标）
var _id = argument0;
warpX[_id] = argument1;
warpY[_id] = argument2;
teleportRoom[_id] = argument3;
teleName[_id] = argument4;
teleX[_id] = argument5;
teleY[_id] = argument6;
